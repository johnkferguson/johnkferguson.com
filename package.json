{
	"name": "johnkferguson-com",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "ASTRO_BUILD=1 astro build && rm -rf dist/lab dist/lab.html",
		"preview": "astro preview",
		"astro": "astro",
		"test": "bun test",
		"lighthouse": "bun scripts/lighthouse.ts",
		"check": "biome check .",
		"check:fix": "biome check --fix ."
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-satteri": "0.4.7",
		"@astrojs/mdx": "^8.1.3",
		"@astrojs/preact": "^6.1.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@fontsource/fira-code": "^5.2.5",
		"@resvg/resvg-js": "^2.6.2",
		"astro": "^7.4.7",
		"hast-util-from-html": "^2.0.3",
		"katex": "^0.19.1",
		"markdown-it": "^15.0.3",
		"preact": "^11.0.1",
		"sanitize-html": "^2.17.6",
		"satteri": "^0.11.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/bun": "^1.4.4",
		"@types/hast": "^3.0.5",
		"@types/sanitize-html": "^2.13.0",
		"chrome-devtools-mcp": "1.12.0",
		"esbuild": "0.28.2",
		"lighthouse": "^13.6.0",
		"typescript": "^6.0.3",
		"yaml": "^2.9.0"
	},
	"npq": {
		"allow": [
			{
				"package": "@astrojs/preact",
				"check": "typosquatting",
				"reason": "Astro's Preact integration, built from withastro/astro with npm trusted publishing; one letter from its sibling @astrojs/react",
				"date": "2026-11-14"
			},
			{
				"package": "satteri",
				"check": "typosquatting",
				"reason": "the Markdown processor behind @astrojs/markdown-satteri, built from bruits/satteri with npm trusted publishing; close in spelling to satori",
				"date": "2026-11-14"
			}
		]
	}
}
