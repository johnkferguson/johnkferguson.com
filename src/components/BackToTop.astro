---
// Floating back-to-top button for narrow viewports. Hidden until the page
// is scrolled well past the first viewport, then fades in bottom-right.
// Scrolls smoothly unless the user prefers reduced motion.
//
// At >=1020px the TOC rail's own Top chip replaces it unconditionally:
// the rail renders that chip for every post now, including ones with no
// headings, so there is no case left where this button is needed at that
// width. It used to be conditional, which is how it came to overlap the
// footer's outbound links on a heading-less post.
---

<button data-back-to-top aria-label="Back to top">
	<span class="btt-arrow" aria-hidden="true">&#8593;</span>
	<span class="btt-label micro-label">Back to top</span>
</button>

<script>
	const btn = document.querySelector<HTMLElement>("[data-back-to-top]");
	if (btn) {
		const reduceMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		/* Native smooth scrolling lands short on mobile: the URL bar expands
		 * mid-animation, resizes the viewport, and truncates the scroll,
		 * leaving the post title clipped under the sticky header. Driving
		 * the animation ourselves keeps it one continuous motion that ends
		 * exactly at 0 regardless of viewport changes. Any real input
		 * cancels it, so an impatient scroll always wins. */
		/* keys that scroll the page; a keydown canceller listening for any
		 * key would kill the animation on Enter's own key repeat, since
		 * Enter activates the button and then repeats while held */
		const SCROLL_KEYS = new Set([
			"ArrowUp",
			"ArrowDown",
			"ArrowLeft",
			"ArrowRight",
			"PageUp",
			"PageDown",
			"Home",
			"End",
			" ",
		]);
		/* a run in flight, so a second click replaces it instead of both
		 * writing conflicting positions every frame */
		let cancelActive: (() => void) | null = null;

		const scrollToTop = () => {
			cancelActive?.();
			const start = window.scrollY;
			if (start <= 0) return;
			if (reduceMotion) {
				window.scrollTo(0, 0);
				return;
			}
			const duration = Math.min(600, Math.max(280, start * 0.32));
			const t0 = performance.now();
			let cancelled = false;
			const onKey = (e: KeyboardEvent) => {
				if (SCROLL_KEYS.has(e.key)) cancel();
			};
			const cancel = () => {
				cancelled = true;
				cleanup();
			};
			const cleanup = () => {
				window.removeEventListener("wheel", cancel);
				window.removeEventListener("touchstart", cancel);
				window.removeEventListener("pointerdown", cancel);
				window.removeEventListener("keydown", onKey);
				if (cancelActive === cancel) cancelActive = null;
			};
			cancelActive = cancel;
			window.addEventListener("wheel", cancel, { passive: true });
			window.addEventListener("touchstart", cancel, { passive: true });
			/* grabbing the scrollbar mid-animation should hand control back */
			window.addEventListener("pointerdown", cancel, { passive: true });
			window.addEventListener("keydown", onKey);
			const step = (now: number) => {
				if (cancelled) return;
				const t = Math.max(0, Math.min(1, (now - t0) / duration));
				/* easeOutCubic displacement from start down to 0: most of
				 * the distance goes early, then a soft landing */
				window.scrollTo(0, Math.round(start * (1 - t) ** 3));
				if (t < 1) {
					requestAnimationFrame(step);
				} else {
					window.scrollTo(0, 0);
					cleanup();
				}
			};
			requestAnimationFrame(step);
		};
		btn.addEventListener("click", scrollToTop);
		const postH1 = document.querySelector<HTMLElement>(".post-header h1");
		let ticking = false;
		const update = () => {
			ticking = false;
			const show = postH1
				? postH1.getBoundingClientRect().bottom < 60
				: window.scrollY > window.innerHeight;
			btn.classList.toggle("visible", show);
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};
		/* the button is display:none at >=1020px, where the rail's Top chip
		 * takes over; skip the scroll work entirely while invisible */
		const wide = window.matchMedia("(min-width: 1020px)");
		const arm = () => {
			if (wide.matches) {
				window.removeEventListener("scroll", onScroll);
			} else {
				update();
				window.addEventListener("scroll", onScroll, { passive: true });
			}
		};
		arm();
		wide.addEventListener("change", arm);
	}
</script>

<style>
	button {
		position: fixed;
		/* tight to the corner: it floats over content and the footer, so
		 * hug the edge to stay out of the way. Only ever shown below
		 * 1020, where the footer is a single centered strand that this
		 * corner clears (measured at 375 and 390 CSS px). */
		right: 0.55rem;
		bottom: 0.55rem;
		z-index: 40;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.22rem;
		padding: 0.5rem 0.7rem 0.42rem;
		border-radius: 8px;
		border: 1px solid color-mix(in srgb, var(--border-color) 55%, var(--date-color));
		background: var(--bg);
		color: var(--text-color);
		box-shadow: var(--float-shadow);
		cursor: pointer;
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		/* visibility keeps the hidden button out of the tab order; its
		 * transition delay lets the fade-out finish first */
		visibility: hidden;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			color 0.15s ease,
			border-color 0.15s ease,
			visibility 0s linear 0.2s;
	}

	.btt-arrow {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		line-height: 1;
	}

	.btt-label {
		/* follow the button's hover color, not micro-label's static gray */
		color: inherit;
		font-size: 0.42rem;
		letter-spacing: 0.12em;
		opacity: 0.75;
	}

	button.visible {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
		visibility: visible;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			color 0.15s ease,
			border-color 0.15s ease,
			visibility 0s;
	}

	button:hover {
		color: var(--heading-color);
		border-color: var(--article-link-hover-border);
	}

	@media (prefers-reduced-motion: reduce) {
		button {
			transition: opacity 0.2s ease;
			transform: none;
		}
	}

	/* the TOC rail carries its own Top chip at wide viewports, for every
	 * post, so this one is never needed there */
	@media (min-width: 1020px) {
		button {
			display: none;
		}
	}
</style>
