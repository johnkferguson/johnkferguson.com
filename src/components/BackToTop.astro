---
// Floating back-to-top button. Hidden until the page is scrolled well past
// the first viewport, then fades in bottom-right. Scrolls smoothly unless
// the user prefers reduced motion.
---

<button data-back-to-top aria-label="Back to top" title="Back to top">
	<svg
		width="16"
		height="16"
		viewBox="0 0 16 16"
		fill="none"
		stroke="currentColor"
		stroke-width="1.8"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"></path>
	</svg>
</button>

<script>
	const btn = document.querySelector<HTMLElement>("[data-back-to-top]");
	if (btn) {
		const reduceMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		btn.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
		});
		let ticking = false;
		const update = () => {
			ticking = false;
			btn.classList.toggle("visible", window.scrollY > window.innerHeight);
		};
		update();
		window.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
	}
</script>

<style>
	button {
		position: fixed;
		right: 1.1rem;
		bottom: 1.1rem;
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 50%;
		border: 1px solid var(--border-color);
		background: var(--bg);
		color: var(--date-color);
		cursor: pointer;
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}

	button.visible {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	button:hover {
		color: var(--heading-color);
		border-color: var(--article-link-hover-border);
	}

	@media (prefers-reduced-motion: reduce) {
		button {
			transition: opacity 0.2s ease;
			transform: none;
		}
	}
</style>
