---
import {
	OG_SIZE,
	SITE_NAME,
	SITE_TAGLINE,
	THEME_COLOR,
	TWITTER_HANDLE,
} from "../consts";

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	type?: "website" | "article";
	pubDate?: Date;
	updated?: Date;
	tags?: string[];
	noindex?: boolean;
}

const {
	title,
	description,
	ogImage = "/assets/og-image.png",
	type = "website",
	pubDate,
	updated,
	tags,
	noindex,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
const fullTitle =
	title === SITE_NAME
		? `${title} | Software Engineer`
		: `${title} | ${SITE_NAME}`;

/* Both the alt text and the dimensions describe OUR generated cards, so
 * both are derived from the resolved path and cannot disagree about
 * which image is in hand. Keying alt off `type` instead would assert a
 * title card for any custom image an article supplied — the same
 * confident-wrong-answer the dimensions guard avoids, in the one field
 * a screen reader actually reads out.
 *
 * The two card routes are matched separately rather than by a shared
 * "/assets/og" prefix, which would also swallow /assets/ogre.png and
 * any future /assets/og-diagram.png. */
const cardPath = new URL(ogImageURL).pathname;
const isPostCard = cardPath.startsWith("/assets/og/");
const isSiteCard = cardPath === "/assets/og-image.png";
const isGeneratedCard = isPostCard || isSiteCard;

/* An image we did not draw gets NO alt rather than a guess. Generic alt
 * ("Card for X") would only repeat the headline the preview already
 * shows, while implying the image holds nothing else — worse than
 * silence for the person relying on it. */
const cardAlt = isPostCard
	? `Title card reading "${title}" over generated artwork`
	: isSiteCard
		? `Card reading "${SITE_NAME}: ${SITE_TAGLINE}" over generated artwork`
		: null;
const authorURL = new URL("/about", Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content={THEME_COLOR} />
<meta name="generator" content={Astro.generator} />

{/* Primary Meta Tags */}
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex" />}

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
{cardAlt && <meta property="og:image:alt" content={cardAlt} />}
{isGeneratedCard && (
	<>
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(OG_SIZE.width)} />
		<meta property="og:image:height" content={String(OG_SIZE.height)} />
	</>
)}
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
{cardAlt && <meta name="twitter:image:alt" content={cardAlt} />}
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />

{/* Article-specific: every article:* tag sits under one type guard, so a
    non-article page that ever passes a pubDate cannot leak them onto an
    og:type="website" page. */}
{type === "article" && (
	<>
		{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
		{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
		<meta property="article:author" content={authorURL} />
		{(tags ?? []).map((tag) => <meta property="article:tag" content={tag} />)}
	</>
)}

{/* RSS */}
<link rel="alternate" type="application/rss+xml" href="/rss.xml" title={`${SITE_NAME}'s Blog`} />

{/* LLM discoverability */}
<link rel="alternate" type="text/plain" href={new URL("/llms.txt", Astro.site).href} title="LLM-friendly site summary" />

{/* Favicon */}
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
