---
/* Dev-only in-place art picker. PostLayout mounts this only when
 * import.meta.env.DEV (via dynamic import), so nothing here ships in
 * production builds.
 *
 * Swaps the live post backdrop in place (same client-side regeneration
 * trick as /lab/art-tuner) so art is judged where it lives: behind the
 * real title, date, TOC, and opening text. The panel overlays the prose
 * column (which already hides the art there), with two previews on top:
 * the full uncropped piece and the homepage-thumbnail crop. Favorite
 * configurations persist in localStorage for flipping between
 * candidates. "Copy frontmatter" emits the art: block to pin. */
---

<div class="art-dev-picker" data-art-picker>
  <button type="button" class="adp-toggle" title="art picker (dev)">✦</button>
  <div class="adp-panel" hidden>
    <div class="adp-previews">
      <div class="adp-prev">
        <div class="adp-prev-full" data-prev-wrap>
          <div class="adp-prev-svg" data-prev-full></div>
          <div class="adp-crop" data-crop-box hidden></div>
        </div>
        <span class="adp-lbl">full piece — drag to pick the thumb crop, double-click to clear</span>
      </div>
      <div class="adp-prev">
        <div class="adp-prev-thumb" data-prev-thumb></div>
        <span class="adp-lbl">home thumb</span>
        <label class="adp-motion"
          ><input type="checkbox" data-motion /> motion (hover thumb)</label
        >
      </div>
    </div>
    <label class="adp-row">
      <span class="adp-lbl">art</span>
      <select data-source></select>
    </label>
    <div class="adp-row">
      <span class="adp-lbl">seed</span>
      <input type="text" data-seed placeholder="(slug)" />
      <button type="button" data-shuffle>shuffle</button>
    </div>
    <div data-dials></div>
    <div class="adp-row adp-actions">
      <button type="button" data-fav>&#9733; save</button>
      <button type="button" data-copy>copy frontmatter</button>
      <button type="button" data-reset>reset</button>
    </div>
    <div class="adp-favs" data-favs></div>
  </div>
</div>

<script>
  import { artSvg, DEFAULT_QUIET, FAMILIES } from "../lib/art/generate";
  import { PIECES } from "../lib/art/pieces";

  interface Crop {
    x: number;
    y: number;
    w: number;
    h: number;
  }

  interface Fav {
    source: string;
    seed: string;
    params: Record<string, number>;
    crop?: Crop | null;
    motion?: boolean;
  }

  const FAVS_KEY = "adp-favs";

  const root = document.querySelector("[data-art-picker]") as HTMLElement;
  const holder = document.querySelector(".backdrop-svg");
  const toggle = root.querySelector(".adp-toggle") as HTMLButtonElement;
  const panel = root.querySelector(".adp-panel") as HTMLElement;
  const source = root.querySelector("[data-source]") as HTMLSelectElement;
  const seedEl = root.querySelector("[data-seed]") as HTMLInputElement;
  const dialsEl = root.querySelector("[data-dials]") as HTMLElement;
  const favsEl = root.querySelector("[data-favs]") as HTMLElement;
  const prevFull = root.querySelector("[data-prev-full]") as HTMLElement;
  const prevWrap = root.querySelector("[data-prev-wrap]") as HTMLElement;
  const cropBox = root.querySelector("[data-crop-box]") as HTMLElement;
  const prevThumb = root.querySelector("[data-prev-thumb]") as HTMLElement;
  const motionEl = root.querySelector("[data-motion]") as HTMLInputElement;
  const copyBtn = root.querySelector("[data-copy]") as HTMLButtonElement;

  const slug = location.pathname.replace(/^\/|\/$/g, "") || "post";
  const params: Record<string, number> = {};
  let crop: Crop | null = null;

  /* the thumb element's display aspect (7.6rem x 5.2rem); crop rects
   * are locked to it so the chosen window fills the thumb exactly */
  const THUMB_ASPECT = 7.6 / 5.2;
  /* full composition is 1600x640: fraction-space height per width that
   * preserves THUMB_ASPECT in pixel space */
  const CROP_H_PER_W = 1600 / 640 / THUMB_ASPECT;

  /* auto = untouched server render; pieces and families are overrides */
  source.innerHTML = [
    `<option value="">(page default)</option>`,
    `<optgroup label="pieces">${Object.keys(PIECES)
      .map((n) => `<option value="piece:${n}">${n}</option>`)
      .join("")}</optgroup>`,
    `<optgroup label="families">${FAMILIES.map(
      (f) => `<option value="family:${f}">${f}</option>`,
    ).join("")}</optgroup>`,
  ].join("");

  const selected = () => {
    const [kind, name] = source.value.split(":");
    return source.value ? { kind, name } : null;
  };

  const buildDials = (overrides?: Record<string, number>) => {
    const sel = selected();
    const piece = sel?.kind === "piece" ? PIECES[sel.name] : null;
    for (const k of Object.keys(params)) delete params[k];
    dialsEl.innerHTML = "";
    if (!piece) return;
    for (const spec of piece.params) {
      const value = overrides?.[spec.key] ?? spec.default;
      params[spec.key] = value;
      const row = document.createElement("label");
      row.className = "adp-row";
      row.innerHTML = `<span class="adp-lbl">${spec.label}</span><input type="range" min="${spec.min}" max="${spec.max}" step="${spec.step}" value="${value}" data-key="${spec.key}" /><output>${value}</output>`;
      const input = row.querySelector("input") as HTMLInputElement;
      const out = row.querySelector("output") as HTMLOutputElement;
      input.addEventListener("input", () => {
        params[spec.key] = Number(input.value);
        out.textContent = input.value;
        regen();
      });
      dialsEl.append(row);
    }
  };

  const artOpts = (width: number, height: number, useQuiet: boolean) => {
    const sel = selected();
    return {
      seedKey: seedEl.value.trim() || slug,
      piece: sel?.kind === "piece" ? sel.name : undefined,
      family:
        sel?.kind === "family"
          ? (sel.name as (typeof FAMILIES)[number])
          : undefined,
      params: { ...params },
      width,
      height,
      quiet: useQuiet ? DEFAULT_QUIET : undefined,
      quietStrength: useQuiet ? 0.4 : undefined,
    };
  };

  const regen = () => {
    /* the live backdrop, exactly as PostLayout generates it */
    if (holder) holder.innerHTML = artSvg(artOpts(1600, 640, true));
    /* full piece, uncropped and unfaded (meet instead of slice) */
    prevFull.innerHTML = artSvg(artOpts(1600, 640, true)).replace(
      "xMidYMid slice",
      "xMidYMid meet",
    );
    /* the homepage thumb, mirroring index.astro: a crop window into
     * the backdrop composition when one is picked, else a fresh
     * same-seed render at thumb proportions */
    const thumbOpts = crop
      ? { ...artOpts(1600, 640, true), crop }
      : artOpts(800, 560, false);
    prevThumb.innerHTML = artSvg({ ...thumbOpts, animate: motionEl.checked });
    /* like the homepage: motion is paused at rest, runs on hover */
    const svg = prevThumb.querySelector("svg") as SVGSVGElement | null;
    if (svg && motionEl.checked) {
      svg.pauseAnimations();
      svg.setCurrentTime(0);
    }
    drawCropBox();
    renderFavs();
  };

  prevThumb.addEventListener("mouseenter", () => {
    prevThumb.querySelector("svg")?.unpauseAnimations();
  });
  prevThumb.addEventListener("mouseleave", () => {
    const svg = prevThumb.querySelector("svg");
    if (svg) {
      svg.pauseAnimations();
      svg.setCurrentTime(0);
    }
  });

  /* ----- thumb crop: drag on the full preview ----- */

  const drawCropBox = () => {
    cropBox.hidden = !crop;
    if (!crop) return;
    cropBox.style.left = `${crop.x * 100}%`;
    cropBox.style.top = `${crop.y * 100}%`;
    cropBox.style.width = `${crop.w * 100}%`;
    cropBox.style.height = `${crop.h * 100}%`;
  };

  const dragFrac = (e: MouseEvent) => {
    const rect = prevWrap.getBoundingClientRect();
    return {
      x: Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width)),
      y: Math.min(1, Math.max(0, (e.clientY - rect.top) / rect.height)),
    };
  };

  const inCrop = (f: { x: number; y: number }) =>
    !!crop &&
    f.x >= crop.x &&
    f.x <= crop.x + crop.w &&
    f.y >= crop.y &&
    f.y <= crop.y + crop.h;

  /* drawing a new rect, or grabbing the existing one to move it */
  let dragStart: { x: number; y: number } | null = null;
  let dragMode: "new" | "move" | null = null;
  let grabOffset = { x: 0, y: 0 };
  prevWrap.addEventListener("mousedown", (e) => {
    const f = dragFrac(e);
    if (crop && inCrop(f)) {
      dragMode = "move";
      grabOffset = { x: f.x - crop.x, y: f.y - crop.y };
    } else {
      dragMode = "new";
      dragStart = f;
    }
    e.preventDefault();
  });
  window.addEventListener("mousemove", (e) => {
    /* cursor telegraphs the two modes */
    if (!dragMode) {
      prevWrap.style.cursor = inCrop(dragFrac(e)) ? "move" : "crosshair";
    }
    if (dragMode === "move" && crop) {
      const f = dragFrac(e);
      crop = {
        ...crop,
        x: Math.min(Math.max(f.x - grabOffset.x, 0), 1 - crop.w),
        y: Math.min(Math.max(f.y - grabOffset.y, 0), Math.max(1 - crop.h, 0)),
      };
      drawCropBox();
      return;
    }
    if (dragMode !== "new" || !dragStart) return;
    const cur = dragFrac(e);
    /* aspect-locked: width leads, height follows */
    const w = Math.max(
      Math.abs(cur.x - dragStart.x),
      Math.abs(cur.y - dragStart.y) / CROP_H_PER_W,
    );
    const h = w * CROP_H_PER_W;
    const x = cur.x < dragStart.x ? dragStart.x - w : dragStart.x;
    const y = cur.y < dragStart.y ? dragStart.y - h : dragStart.y;
    crop = {
      x: Math.min(Math.max(x, 0), 1 - w),
      y: Math.min(Math.max(y, 0), Math.max(1 - h, 0)),
      w,
      h: Math.min(h, 1),
    };
    drawCropBox();
  });
  window.addEventListener("mouseup", () => {
    if (!dragMode) return;
    const wasNew = dragMode === "new";
    dragMode = null;
    dragStart = null;
    /* a mere click is not a crop */
    if (wasNew && crop && crop.w < 0.03) crop = null;
    regen();
  });
  prevWrap.addEventListener("dblclick", () => {
    crop = null;
    regen();
  });

  /* ----- favorites (localStorage) ----- */

  const currentFav = (): Fav => ({
    source: source.value,
    seed: seedEl.value.trim(),
    params: { ...params },
    crop,
    motion: motionEl.checked,
  });

  const loadFavs = (): Fav[] => {
    try {
      return JSON.parse(localStorage.getItem(FAVS_KEY) ?? "[]");
    } catch {
      return [];
    }
  };

  const storeFavs = (favs: Fav[]) => {
    localStorage.setItem(FAVS_KEY, JSON.stringify(favs));
  };

  const favLabel = (f: Fav) => {
    const name = f.source ? f.source.split(":")[1] : "default";
    const sel = f.source.split(":");
    const piece = sel[0] === "piece" ? PIECES[sel[1]] : null;
    const changed = piece
      ? piece.params
          .filter((s) => f.params[s.key] !== undefined && f.params[s.key] !== s.default)
          .map((s) => `${s.key} ${f.params[s.key]}`)
          .join(", ")
      : "";
    const extras = [changed, f.crop ? "crop" : "", f.motion ? "motion" : ""]
      .filter(Boolean)
      .join(" · ");
    return `${name} · ${f.seed || "(slug)"}${extras ? ` · ${extras}` : ""}`;
  };

  const applyFav = (f: Fav) => {
    source.value = f.source;
    if (source.value !== f.source) source.value = ""; // piece no longer exists
    seedEl.value = f.seed;
    crop = f.crop ?? null;
    motionEl.checked = f.motion ?? false;
    buildDials(f.params);
    regen();
  };

  const renderFavs = () => {
    const favs = loadFavs();
    const now = JSON.stringify(currentFav());
    favsEl.innerHTML = "";
    favs.forEach((f, i) => {
      const row = document.createElement("div");
      row.className = "adp-fav";
      if (JSON.stringify(f) === now) row.classList.add("adp-fav-active");
      const apply = document.createElement("button");
      apply.type = "button";
      apply.className = "adp-fav-apply";
      apply.textContent = favLabel(f);
      apply.addEventListener("click", () => applyFav(f));
      const del = document.createElement("button");
      del.type = "button";
      del.className = "adp-fav-del";
      del.textContent = "×";
      del.title = "remove";
      del.addEventListener("click", () => {
        const next = loadFavs();
        next.splice(i, 1);
        storeFavs(next);
        renderFavs();
      });
      row.append(apply, del);
      favsEl.append(row);
    });
  };

  /* ----- panel placement: overlay the prose column ----- */

  const placePanel = () => {
    /* the article, not .post-main: the main column's box runs wider
     * than the prose measure and a panel that wide obscures art in the
     * right margin */
    const article = document.querySelector(".post-main article");
    if (!article) return;
    const rect = article.getBoundingClientRect();
    panel.style.left = `${Math.max(8, rect.left)}px`;
    panel.style.width = `${Math.min(rect.width, window.innerWidth - 16)}px`;
    /* top edge aligns with where the text content begins, so the
     * title and the art behind it stay visible; once that scrolls away
     * the panel may use the full height */
    const avail = window.innerHeight - Math.max(rect.top, 0) - 26;
    panel.style.maxHeight = `${Math.max(240, avail)}px`;
  };

  /* ----- events ----- */

  toggle.addEventListener("click", () => {
    panel.hidden = !panel.hidden;
    if (!panel.hidden) {
      placePanel();
      regen();
    }
  });
  window.addEventListener("resize", () => {
    if (!panel.hidden) placePanel();
  });
  window.addEventListener(
    "scroll",
    () => {
      if (!panel.hidden) placePanel();
    },
    { passive: true },
  );
  source.addEventListener("input", () => {
    buildDials();
    regen();
  });
  seedEl.addEventListener("input", regen);
  motionEl.addEventListener("input", regen);
  (root.querySelector("[data-shuffle]") as HTMLElement).addEventListener(
    "click",
    () => {
      seedEl.value = Math.random().toString(36).slice(2, 8);
      regen();
    },
  );
  (root.querySelector("[data-fav]") as HTMLElement).addEventListener(
    "click",
    () => {
      const favs = loadFavs();
      const me = JSON.stringify(currentFav());
      if (!favs.some((f) => JSON.stringify(f) === me)) {
        favs.push(currentFav());
        storeFavs(favs);
      }
      renderFavs();
    },
  );
  (root.querySelector("[data-reset]") as HTMLElement).addEventListener(
    "click",
    () => {
      source.value = "";
      seedEl.value = "";
      crop = null;
      motionEl.checked = false;
      buildDials();
      location.reload();
    },
  );
  copyBtn.addEventListener("click", async () => {
    const sel = selected();
    const lines = ["art:"];
    if (sel?.kind === "piece") lines.push(`  piece: ${sel.name}`);
    if (sel?.kind === "family") lines.push(`  family: ${sel.name}`);
    const seed = seedEl.value.trim();
    if (seed) lines.push(`  seed: ${seed}`);
    const piece = sel?.kind === "piece" ? PIECES[sel.name] : null;
    const changed = piece
      ? piece.params.filter((s) => params[s.key] !== s.default)
      : [];
    if (changed.length > 0) {
      lines.push("  params:");
      for (const s of changed) lines.push(`    ${s.key}: ${params[s.key]}`);
    }
    if (crop) {
      lines.push("  thumb:");
      for (const k of ["x", "y", "w", "h"] as const)
        lines.push(`    ${k}: ${crop[k].toFixed(3)}`);
    }
    if (motionEl.checked) lines.push("  motion: true");
    await navigator.clipboard.writeText(`${lines.join("\n")}\n`);
    copyBtn.textContent = "copied";
    setTimeout(() => {
      copyBtn.textContent = "copy frontmatter";
    }, 1200);
  });

  if (!holder) {
    toggle.disabled = true;
    toggle.title = "art picker: this page uses a frontmatter image";
  }
</script>

<!-- global because dial and favorite rows are created by the script and
     would miss Astro's scoped-style attribute; everything nests under
     the root class so nothing leaks (dev-only anyway) -->
<style is:global>
  .art-dev-picker {
    font-family: var(--font-mono);
  }

  /* bottom-right, lifted clear of back-to-top's narrow-layout spot */
  .art-dev-picker .adp-toggle {
    position: fixed;
    right: 0.55rem;
    bottom: 3.1rem;
    z-index: 91;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: var(--bg);
    color: var(--code-color);
    box-shadow: var(--float-shadow);
    cursor: pointer;
    font-size: 0.85rem;
  }

  .art-dev-picker .adp-toggle:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* overlays the prose column (left/width set by script from
   * .post-main's rect); the content already hides the art there */
  .art-dev-picker .adp-panel {
    position: fixed;
    bottom: 0.55rem;
    z-index: 90;
    /* max-height is set by the script so the panel stays below the
     * backdrop art; this is only the pre-placement fallback */
    max-height: 50vh;
    overflow-y: auto;
    padding: 0.8rem 0.9rem;
    background: var(--bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    box-shadow: var(--float-shadow);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .art-dev-picker .adp-previews {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .art-dev-picker .adp-prev {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .art-dev-picker .adp-prev:first-child {
    flex: 1;
  }

  .art-dev-picker .adp-prev-full {
    position: relative;
    aspect-ratio: 2.5;
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    cursor: crosshair;
  }

  .art-dev-picker .adp-prev-svg {
    width: 100%;
    height: 100%;
  }

  .art-dev-picker .adp-crop {
    position: absolute;
    border: 1px dashed var(--code-color);
    background: color-mix(in srgb, var(--code-color) 10%, transparent);
    pointer-events: none;
  }

  .art-dev-picker .adp-motion {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.52rem;
    color: var(--date-color);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .art-dev-picker .adp-motion input {
    accent-color: var(--code-color);
    margin: 0;
  }

  /* the homepage list treatment at its real size (see index.astro) */
  .art-dev-picker .adp-prev-thumb {
    width: 7.6rem;
    height: 5.2rem;
    -webkit-mask-image: radial-gradient(
      ellipse 92% 88% at 50% 50%,
      #000 45%,
      transparent 98%
    );
    mask-image: radial-gradient(
      ellipse 92% 88% at 50% 50%,
      #000 45%,
      transparent 98%
    );
  }

  .art-dev-picker .adp-prev-svg svg,
  .art-dev-picker .adp-prev-thumb svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .art-dev-picker .adp-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.6rem;
  }

  .art-dev-picker .adp-lbl {
    flex: none;
    width: 3.6rem;
    color: var(--date-color);
    font-size: 0.52rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .art-dev-picker .adp-prev .adp-lbl {
    width: auto;
  }

  .art-dev-picker select,
  .art-dev-picker input[type="text"],
  .art-dev-picker .adp-panel button {
    font-family: inherit;
    font-size: 0.6rem;
    color: var(--text-color);
    background: var(--code-background);
    border: 1px solid var(--border-color);
    border-radius: 5px;
    padding: 0.2rem 0.4rem;
    min-width: 0;
    cursor: pointer;
  }

  .art-dev-picker select {
    flex: 1;
    max-width: 18rem;
  }

  .art-dev-picker input[type="text"] {
    flex: none;
    width: 7rem;
    cursor: text;
  }

  .art-dev-picker input[type="range"] {
    flex: 1;
    max-width: 16rem;
    min-width: 0;
    accent-color: var(--code-color);
  }

  .art-dev-picker output {
    min-width: 2.2em;
    text-align: right;
    color: var(--heading-color);
    font-size: 0.58rem;
  }

  .art-dev-picker .adp-panel button:hover {
    color: var(--heading-color);
    border-color: var(--date-color);
  }

  .art-dev-picker .adp-actions {
    justify-content: flex-start;
  }

  .art-dev-picker .adp-favs {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .art-dev-picker .adp-fav {
    display: flex;
    gap: 0.3rem;
    align-items: stretch;
  }

  .art-dev-picker .adp-fav-apply {
    flex: 1;
    text-align: left;
  }

  .art-dev-picker .adp-fav-active .adp-fav-apply {
    border-color: var(--code-color);
    color: var(--heading-color);
  }

  .art-dev-picker .adp-fav-del {
    flex: none;
  }
</style>
