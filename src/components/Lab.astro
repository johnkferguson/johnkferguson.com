---
// Generic frame for interactive lab embeds. Renders the shared title
// strip (static HTML, so it shows before the island hydrates) and the
// deep-link anchor; the labs markdown plugin reads <Lab> tags at build
// time to surface each lab in the table of contents.
//
// The strip reproduces the lab panel's top edge (background, side
// borders, rounded top corners); the lab components render their panels
// with squared, borderless tops so the two meet seamlessly.
import { labSlug } from "../markdown/labs.mjs";

interface Props {
	title: string;
	/** Anchor id; defaults to lab-<slugged title>. */
	id?: string;
}
const { title, id = `lab-${labSlug(title)}` } = Astro.props;

/* the TOC's beaker, at strip size: green fill + surface line paint
 * first, the full currentColor outline paints last so the flask border
 * stays whole at the waterline */
const beakerSvg =
	'<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 16h10l2.28 4.55a1 1 0 0 1-.9 1.45H5.62a1 1 0 0 1-.9-1.45Z" stroke="none" fill="var(--lab-beaker)"/><path d="M7 16h10" stroke="var(--lab-beaker)"/><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/></svg>';
---

<div class="labwrap" id={id}>
	<div class="lab-head">
		<span class="lab-beaker" set:html={beakerSvg} />
		<span>{title}</span>
	</div>
	<slot />
</div>

<script>
	import { labEventPath, shouldCount, type LabEventKind } from "../lib/analytics";

	/* GoatCounter events: "seen" when half a lab is on screen, "used" on the
	 * first input inside it, each at most once per page view. Wired here so
	 * every <Lab> is tracked without touching the lab components. */
	type GoatCounter = { count?: (vars: { path: string; title: string; event: boolean }) => void };

	const send = (path: string) => {
		const gc = (window as { goatcounter?: GoatCounter }).goatcounter;
		const fire = () => gc?.count?.({ path, title: document.title, event: true });
		if (gc?.count) return fire();
		/* count.js loads async, so the first lab can scroll in before it
		 * arrives; if a blocker drops it, this never fires */
		document
			.querySelector("script[data-goatcounter]")
			?.addEventListener("load", fire, { once: true });
	};

	if (shouldCount(location.hostname)) {
		const track = (el: HTMLElement, kind: LabEventKind) =>
			send(labEventPath(location.pathname, el.id, kind));

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer.unobserve(entry.target);
					track(entry.target as HTMLElement, "seen");
				}
			},
			{ threshold: 0.5 },
		);

		for (const el of document.querySelectorAll<HTMLElement>(".labwrap")) {
			observer.observe(el);
			const used = () => {
				el.removeEventListener("pointerdown", used);
				el.removeEventListener("keydown", used);
				track(el, "used");
			};
			el.addEventListener("pointerdown", used);
			el.addEventListener("keydown", used);
		}
	}
</script>

<style>
	.lab-head {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		background: var(--code-background);
		border: 1px solid var(--border-color);
		border-bottom: 0;
		border-radius: 8px 8px 0 0;
		/* 10px above the text and 4px below: with the panel's 6px top
		 * padding underneath, the text sits 10px from both the strip's
		 * border and the dial grid's separator line, matching the spacing
		 * the labs had when they rendered this strip themselves */
		padding: 10px 4px 4px;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 13.5px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--heading-color);
	}

	.lab-beaker {
		display: flex;
		flex: none;
		/* the liquid in the beaker. A variable rather than a literal in the
		 * markup: that SVG is a string interpolated through set:html, which a
		 * scoped rule cannot reach into but an inherited property can. */
		--lab-beaker: #5a9367;
	}
</style>
