---
// Thin single-line footer: a mono strand with the year and the site's
// outbound surfaces. No email by design.
//
// One centered strand below 1020px, splitting to the two gutters above
// it: year and source left, outbound links right. Keyed to the TOC rail's
// breakpoint because the rail is what makes the difference. In
// single-column mode .post-shell is margin-inline:auto, so the article
// is genuinely centered and a centered footer lines up with it. Once
// the rail appears the grid pushes the content column right of center,
// and a single centered strand reads as a near miss rather than a
// choice; split, it frames the column instead of competing with it.
//
// The inner wrapper mirrors the header's shell-max constraint so the
// two ends line up with the wordmark and the nav above them. The
// border stays full width.
const year = new Date().getFullYear();
const githubUsername = "johnkferguson";
const twitterUsername = "johnkferguson";
const repoUrl = `https://github.com/${githubUsername}/johnkferguson.com`;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <span class="footer-copy">
      <span data-year>© {year}</span>
      <span class="sep">·</span>
      <a href={repoUrl} rel="noopener noreferrer" target="_blank">Source</a>
    </span>
    <span class="sep group-sep">·</span>
    <span class="footer-links">
      <a
        href={`https://github.com/${githubUsername}`}
        rel="me noopener noreferrer"
        target="_blank">GitHub</a
      >
      <span class="sep">·</span>
      <a
        href={`https://x.com/${twitterUsername}`}
        rel="me noopener noreferrer"
        target="_blank">X</a
      >
      <span class="sep">·</span>
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<script>
	// year is baked at build; correct it client-side if a deploy hasn't
	// crossed the year boundary yet
	const el = document.querySelector<HTMLElement>("[data-year]");
	if (el) {
		const now = `© ${new Date().getFullYear()}`;
		if (el.textContent !== now) el.textContent = now;
	}
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--border-color);
    padding: 0.55rem 0;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    color: var(--date-color);
  }

  /* mirrors .site-header-inner, so once the strand splits its two ends
   * land on the same left and right edges as the wordmark and the nav */
  .site-footer-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: 0 var(--shell-pad);
  }

  /* both ends are groups now, so each keeps its own members together and
   * space-between still sees exactly two things to push apart */
  .footer-copy,
  .footer-links {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* Anchor the strand left on the narrowest viewports.
   *
   * Centered, its right end reaches into the corner the floating Back to
   * top button occupies, and the button paints an opaque background, so
   * any overlap eats a glyph rather than crowding one. Left-anchored the
   * strand moves clear of that corner and lands on the wordmark's left
   * edge, the same mirroring the split layout does above 1020. */
  @media (max-width: 380px) {
    .site-footer-inner {
      justify-content: flex-start;
    }
  }

  /* the rail's breakpoint: see the note at the top of this file */
  @media (min-width: 1020px) {
    /* A fixed band with the strand centered in it, rather than padding
     * either side of the text: 0.55rem left the hairline 12px above and
     * 5px below, reading as if the text hung off the line. Centering
     * makes the two equal by construction, and the explicit height is
     * what the rail's Top chip cancels (see --footer-h). Scoped to this
     * breakpoint; narrower viewports keep the roomier padded default. */
    .site-footer {
      height: var(--footer-h);
      padding-top: 0;
      padding-bottom: 0;
    }

    /* copyright to the left gutter, outbound links to the right; DOM
     * order already reads that way, so nothing needs reordering */
    .site-footer-inner {
      height: 100%;
      justify-content: space-between;
    }

    /* the strand separator only makes sense while it is one strand */
    .group-sep {
      display: none;
    }

    /* Halfway back toward the old 0.55rem. The tighter mobile value is
     * there because the strand has to fit beside the floating Top button;
     * at this width that button is gone and the two groups sit in their
     * own gutters, so the separators can breathe again. */
    .footer-copy,
    .footer-links {
      gap: 0.475rem;
    }
  }

  .site-footer a {
    color: var(--date-color);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer a:hover {
    color: var(--heading-color);
  }

  .sep {
    opacity: 0.5;
  }
</style>
