---
// Thin single-line footer: centered mono strand with the year and the
// site's outbound surfaces. No email by design.
const year = new Date().getFullYear();
const githubUsername = "johnkferguson";
const twitterUsername = "johnkferguson";
---

<footer class="site-footer">
  <span>© {year}</span>
  <span class="sep">·</span>
  <a href={`https://github.com/${githubUsername}`} rel="me">GitHub</a>
  <span class="sep">·</span>
  <a href={`https://x.com/${twitterUsername}`} rel="me">X</a>
  <span class="sep">·</span>
  <a href="/rss.xml">RSS</a>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-top: 1px solid var(--border-color);
    padding: 0.55rem var(--shell-pad);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    color: var(--date-color);
  }

  .site-footer a {
    color: var(--date-color);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer a:hover {
    color: var(--heading-color);
  }

  .sep {
    opacity: 0.5;
  }
</style>
