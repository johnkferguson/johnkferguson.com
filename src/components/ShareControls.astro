---
/* End-of-post sharing strand.
 *
 * Both buttons are rendered server-side and hidden; the script reveals
 * whichever the visitor's capabilities call for (see lib/share.ts).
 * Rendering both and hiding keeps the markup declarative.
 *
 * Each is a bordered control rather than a bare label: on touch there is
 * no hover to reveal that a word is pressable, and this is the one thing
 * a reader is invited to do at the end of a post. The outline stays
 * quiet (hairline, no fill) so it reads as a control without competing
 * with the prose. Being outlined, they need no separator between them.
 *
 * Starting hidden also handles the no-JavaScript case: neither control
 * can function without it, so neither should be visible. Same shape as
 * BackToTop, which is invisible until its script marks it .visible.
 * There is no label flash to worry about because the strand sits below
 * the fold, long read by the time anyone scrolls to it.
 */
---

<div class="share" data-share hidden>
  <button class="share-btn" type="button" data-share-copy hidden>
    <svg
      class="i-copy"
      width="11"
      height="11"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
    </svg>
    <svg
      class="i-check"
      width="11"
      height="11"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
    <span data-share-copy-label>Copy link</span>
  </button>

  <button class="share-btn" type="button" data-share-share hidden>
    <svg
      width="11"
      height="11"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
      <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
    </svg>
    <span>Share</span>
  </button>
</div>

<script>
	import { attachCopyButton } from "./copy-link";
	import { shareControls } from "../lib/share";

	const strand = document.querySelector<HTMLElement>("[data-share]");
	const copyBtn = strand?.querySelector<HTMLElement>("[data-share-copy]");
	const shareBtn = strand?.querySelector<HTMLElement>("[data-share-share]");

	if (strand && copyBtn && shareBtn) {
		const label = copyBtn.querySelector<HTMLElement>("[data-share-copy-label]");

		/* the accessible name comes from the visible text, so the two can
		 * never drift apart as the state changes. Which icon shows is a
		 * CSS consequence of .copied, so there is one source of truth. */
		const paint = (done: boolean) => {
			copyBtn.classList.toggle("copied", done);
			if (label) label.textContent = done ? "Copied" : "Copy link";
		};

		const copyNow = attachCopyButton(copyBtn, {
			url: () => location.href,
			idle: () => paint(false),
			copied: () => paint(true),
		});

		shareBtn.addEventListener("click", async () => {
			try {
				/* called first, with nothing awaited before it: the Web Share
				 * API requires the user gesture to still be active */
				await navigator.share({ title: document.title, url: location.href });
			} catch (err) {
				/* dismissing the sheet is a choice, not a failure */
				if (err instanceof DOMException && err.name === "AbortError") return;
				/* anything else (share unavailable mid-flight, bad payload)
				 * degrades to the copy path rather than doing nothing */
				await copyNow();
			}
		});

		const controls = shareControls({
			hasShare: typeof navigator.share === "function",
			coarsePointer: window.matchMedia("(pointer: coarse)").matches,
		});
		copyBtn.toggleAttribute("hidden", !controls.includes("copy"));
		shareBtn.toggleAttribute("hidden", !controls.includes("share"));
		strand.removeAttribute("hidden");
	}
</script>

<style>
  .share {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    max-width: var(--prose-measure);
    margin: 2.4rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-color);
  }

  .share[hidden] {
    display: none;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    /* hairline, no fill: enough to read as pressable without becoming
     * the loudest thing on the page. Same border tokens and hover
     * treatment as the rail's Top chip, so the site has one button
     * voice rather than two. */
    border: 1px solid var(--border-color);
    border-radius: 5px;
    padding: 0.3rem 0.55rem;
    background: transparent;
    color: var(--date-color);
    cursor: pointer;
    font-family: var(--font-mono);
    /* barely above the footer's 0.55rem: the outline already says this
     * is pressable, so the type does not have to, and it sits under the
     * prose where anything larger pulls focus */
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .share-btn[hidden] {
    display: none;
  }

  .share-btn svg {
    display: block;
    width: 11px;
    height: 11px;
    /* the mono cap band sits above the line-box middle at this size */
    transform: translateY(-0.5px);
  }

  .share-btn:hover {
    color: var(--heading-color);
    border-color: var(--article-link-hover-border);
  }

  /* the confirmation carries the border too: on an outlined control a
   * text-colour-only change is easy to miss */
  .share-btn.copied {
    color: var(--code-color);
    border-color: var(--code-color);
  }

  /* the confirmed state swaps the glyph; .copied is the single source of
   * truth for it, so the script never touches the icons directly */
  .share-btn .i-check {
    display: none;
  }

  .share-btn.copied .i-copy {
    display: none;
  }

  .share-btn.copied .i-check {
    display: block;
  }

  /* Touch. On a phone this is the only control in reach at the end of
   * the post, and usually the only one shown at all (the OS sheet covers
   * copy), so it carries more weight than the desktop control does. Type
   * and glyph both scale up, and min-height is stated outright rather
   * than left to padding: derived from font metrics the target came out
   * ~15px tall, well under the 44px guideline. */
  @media (hover: none) {
    .share {
      padding-top: 1.4rem;
    }

    .share-btn {
      min-height: 52px;
      gap: 0.55rem;
      padding: 0 1rem;
      border-radius: 6px;
      font-size: 0.9rem;
      letter-spacing: 0.1em;
    }

    .share-btn svg {
      width: 17px;
      height: 17px;
      transform: none;
    }
  }
</style>
