---
import { SITE_CARD_PATH, SITE_DESCRIPTION, SITE_NAME } from "../consts";
import { canonicalPath } from "../lib/canonical";

interface Props {
	type: "website" | "article";
	title: string;
	description: string;
	ogImage?: string;
	pubDate?: Date;
	updated?: Date;
	tags?: string[];
}

const { type, title, description, ogImage, pubDate, updated, tags } =
	Astro.props;

const url = new URL(canonicalPath(Astro.url.pathname), Astro.site).href;
const siteUrl = Astro.site?.href ?? "https://johnkferguson.com";
const ogImageURL = ogImage
	? new URL(ogImage, Astro.site).href
	: new URL(SITE_CARD_PATH, Astro.site).href;

const personSchema = {
	"@type": "Person",
	"@id": `${siteUrl}#person`,
	name: SITE_NAME,
	url: siteUrl,
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_NAME,
	description: SITE_DESCRIPTION,
	url: siteUrl,
	author: personSchema,
};

const pageSchema =
	type === "article"
		? {
				"@context": "https://schema.org",
				"@type": "Article",
				headline: title,
				description,
				url,
				image: ogImageURL,
				/* the same Person entity the WebSite points at, by @id, so
				 * the author's name is stated in exactly one place and an
				 * article can never attribute someone the site does not
				 * claim as its author */
				author: personSchema,
				...(pubDate && { datePublished: pubDate.toISOString() }),
				/* Guarded on (updated ?? pubDate), not on updated: an
				 * unrevised post still states a dateModified, from its
				 * publish date, rather than reading as one of unknown
				 * freshness. */
				...((updated ?? pubDate) && {
					dateModified: (updated ?? pubDate)?.toISOString(),
				}),
				/* an array, not a joined string, so a tag containing a
				 * comma cannot be re-split into two by a consumer */
				...(tags?.length && { keywords: tags }),
				mainEntityOfPage: { "@id": url },
			}
		: {
				"@context": "https://schema.org",
				"@type": "WebPage",
				name: title,
				description,
				url,
				author: personSchema,
			};
/* escape < so content can never close the script tag early */
const ld = (schema: object) => JSON.stringify(schema).replace(/</g, "\\u003c");
---

<script is:inline type="application/ld+json" set:html={ld(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={ld(pageSchema)} />
