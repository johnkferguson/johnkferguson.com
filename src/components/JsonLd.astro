---
import { SITE_DESCRIPTION, SITE_NAME } from "../consts";

interface Props {
	type: "website" | "article";
	title: string;
	description: string;
	image?: string;
	pubDate?: Date;
	author?: string;
}

const {
	type,
	title,
	description,
	image,
	pubDate,
	author = SITE_NAME,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = Astro.site?.href ?? "https://johnkferguson.com";
const ogImageURL = image
	? new URL(image, Astro.site).href
	: new URL("/assets/og-image.png", Astro.site).href;

const personSchema = {
	"@type": "Person",
	"@id": `${siteUrl}#person`,
	name: SITE_NAME,
	url: siteUrl,
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_NAME,
	description: SITE_DESCRIPTION,
	url: siteUrl,
	author: personSchema,
};

const pageSchema =
	type === "article"
		? {
				"@context": "https://schema.org",
				"@type": "Article",
				headline: title,
				description,
				url,
				image: ogImageURL,
				author: {
					"@type": "Person",
					name: author,
				},
				...(pubDate && { datePublished: pubDate.toISOString() }),
				mainEntityOfPage: { "@id": url },
			}
		: {
				"@context": "https://schema.org",
				"@type": "WebPage",
				name: title,
				description,
				url,
				author: personSchema,
			};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
