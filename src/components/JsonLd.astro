---
import { SITE_DESCRIPTION, SITE_NAME } from "../consts";

interface Props {
	type: "website" | "article";
	title: string;
	description: string;
	ogImage?: string;
	pubDate?: Date;
	updated?: Date;
	tags?: string[];
	author?: string;
}

const {
	type,
	title,
	description,
	ogImage,
	pubDate,
	updated,
	tags,
	author = SITE_NAME,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = Astro.site?.href ?? "https://johnkferguson.com";
const ogImageURL = ogImage
	? new URL(ogImage, Astro.site).href
	: new URL("/assets/og-image.png", Astro.site).href;

const personSchema = {
	"@type": "Person",
	"@id": `${siteUrl}#person`,
	name: SITE_NAME,
	url: siteUrl,
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_NAME,
	description: SITE_DESCRIPTION,
	url: siteUrl,
	author: personSchema,
};

const pageSchema =
	type === "article"
		? {
				"@context": "https://schema.org",
				"@type": "Article",
				headline: title,
				description,
				url,
				image: ogImageURL,
				author: {
					"@type": "Person",
					name: author,
				},
				...(pubDate && { datePublished: pubDate.toISOString() }),
				/* Guarded on (updated ?? pubDate), not on updated: an
				 * unrevised post still states a dateModified, from its
				 * publish date, rather than reading as one of unknown
				 * freshness. */
				...((updated ?? pubDate) && {
					dateModified: (updated ?? pubDate)?.toISOString(),
				}),
				/* an array, not a joined string, so a tag containing a
				 * comma cannot be re-split into two by a consumer */
				...(tags?.length && { keywords: tags }),
				mainEntityOfPage: { "@id": url },
			}
		: {
				"@context": "https://schema.org",
				"@type": "WebPage",
				name: title,
				description,
				url,
				author: personSchema,
			};
/* escape < so content can never close the script tag early */
const ld = (schema: object) => JSON.stringify(schema).replace(/</g, "\\u003c");
---

<script is:inline type="application/ld+json" set:html={ld(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={ld(pageSchema)} />
