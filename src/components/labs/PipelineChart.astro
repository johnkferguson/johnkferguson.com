---
// One auction's pipeline as a static fork-join chart. Nodes link to the
// matching h3 subsections below it in the article. Color carries the
// marginal-cost story: gray nodes are the venue's existing work, purple
// nodes are unique to the mechanism, gradient nodes are a blend of both.
// Zero client JS; themes through the lab CSS variables.
import "./snapshot-fees-lab.css";
---

<div class="sf-lab pipeline-chart">
	<svg
		viewBox="0 0 640 318"
		role="img"
		aria-label="Flowchart of one auction: seal the auction, then calculate the mark and match in parallel, then price the fills, then close the window"
	>
		<defs>
			<linearGradient id="pc-blend" x1="0" y1="0" x2="1" y2="0">
				<stop offset="0" style="stop-color: var(--lab-faint)"></stop>
				<stop offset="1" style="stop-color: var(--lab-mark)"></stop>
			</linearGradient>
			<marker
				id="pc-arrow"
				viewBox="0 0 8 8"
				refX="7"
				refY="4"
				markerWidth="7"
				markerHeight="7"
				orient="auto-start-reverse"
			>
				<path d="M0,0 L8,4 L0,8 Z" style="fill: var(--lab-dim)"></path>
			</marker>
		</defs>

		<!-- edges -->
		<g style="stroke: var(--lab-dim)" stroke-width="1.25" fill="none">
			<path d="M300,64 L206,98" marker-end="url(#pc-arrow)"></path>
			<path d="M340,64 L434,98" marker-end="url(#pc-arrow)"></path>
			<path d="M190,148 L296,190" marker-end="url(#pc-arrow)"></path>
			<path d="M450,148 L344,190" marker-end="url(#pc-arrow)"></path>
			<path d="M320,240 L320,258" marker-end="url(#pc-arrow)"></path>
		</g>

		<!-- Seal the Auction: the venue's existing work -->
		<a href="#seal-the-auction">
			<rect x="225" y="20" width="190" height="44" rx="7" class="pc-node pc-venue"
			></rect>
			<text x="320" y="47">Seal the Auction</text>
		</a>

		<!-- Calculate the Mark: unique to the mechanism -->
		<a href="#calculate-the-mark">
			<rect x="60" y="104" width="220" height="44" rx="7" class="pc-node pc-ours"
			></rect>
			<text x="170" y="131">Calculate the Mark</text>
		</a>

		<!-- Match: the venue's existing work -->
		<a href="#match">
			<rect x="380" y="104" width="160" height="44" rx="7" class="pc-node pc-venue"
			></rect>
			<text x="460" y="131">Match</text>
		</a>

		<!-- Price the Fills: a blend -->
		<a href="#price-the-fills">
			<rect x="225" y="196" width="190" height="44" rx="7" class="pc-node pc-blend"
			></rect>
			<text x="320" y="223">Price the Fills</text>
		</a>

		<!-- Close the Window: a blend -->
		<a href="#close-the-window">
			<rect x="225" y="262" width="190" height="44" rx="7" class="pc-node pc-blend"
			></rect>
			<text x="320" y="289">Close the Window</text>
		</a>
	</svg>
	<div class="pc-legend">
		<span><i class="pc-sw pc-sw-venue"></i> The venue's existing work</span>
		<span><i class="pc-sw pc-sw-ours"></i> Unique to the mechanism</span>
		<span><i class="pc-sw pc-sw-blend"></i> Both</span>
	</div>
</div>

<style>
	.pipeline-chart {
		margin: 1.25rem 0 1.75rem;
	}

	.pipeline-chart svg {
		width: 100%;
		display: block;
	}

	.pipeline-chart text {
		font-family: var(--lab-mono);
		font-size: 14.5px;
		text-anchor: middle;
		fill: var(--lab-text);
	}

	.pc-node {
		fill: var(--lab-panel);
		stroke-width: 1.75;
	}

	.pc-venue {
		stroke: var(--lab-faint);
	}

	.pc-ours {
		stroke: var(--lab-mark);
	}

	.pc-blend {
		stroke: url(#pc-blend);
	}

	.pipeline-chart a {
		cursor: pointer;
	}

	.pipeline-chart a:hover .pc-node {
		stroke-width: 2.75;
	}

	.pc-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 18px;
		justify-content: center;
		font-family: var(--lab-mono);
		font-size: 11px;
		color: var(--lab-dim);
		margin-top: 2px;
	}

	.pc-sw {
		display: inline-block;
		width: 20px;
		height: 9px;
		border-radius: 3px;
		vertical-align: baseline;
	}

	.pc-sw-venue {
		border: 1.5px solid var(--lab-faint);
	}

	.pc-sw-ours {
		border: 1.5px solid var(--lab-mark);
	}

	.pc-sw-blend {
		border: 1.5px solid transparent;
		background:
			linear-gradient(var(--lab-panel), var(--lab-panel)) padding-box,
			linear-gradient(90deg, var(--lab-faint), var(--lab-mark)) border-box;
	}
</style>
