---
import { SITE_NAME } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="border-t pt-2 min-h-[2.4rem] leading-[2.1rem]" style="border-color: var(--heading-color);">
  <div class="max-w-[720px] mx-auto px-3 flex items-center justify-between">
    <a
      href="/"
      class="block text-[1.5rem] tracking-[-1px] relative border-b z-[1] font-normal"
      style="color: var(--heading-color); border-color: var(--heading-color);"
    >
      {SITE_NAME}
    </a>
    <nav class="flex items-center gap-4">
      <a
        href="/about"
        class="text-[1rem] link-underline transition-colors"
        style="color: var(--heading-color);"
      >
        About
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
