---
// Section navigation. Auto-discovers h2[id]/h3[id] headings inside the
// element marked data-toc-root. Two variants:
//   <TableOfContents />        sticky left rail: nested accordion with
//                              carets, two-level scrollspy, Top link
//   <TableOfContents inline /> in-flow Contents block (flat h2 list),
//                              shown when the rail does not fit
interface Props {
	inline?: boolean;
}
const { inline = false } = Astro.props;
---

<nav
	class={inline ? "toc toc-inline" : "toc toc-rail"}
	data-toc
	aria-label="Sections"
>
	<div class="toc-scroll">
		<span class="toc-title">Contents</span>
		<ul></ul>
	</div>
	{
		!inline && (
			<button class="toc-top" data-toc-top type="button">
				<span class="toc-top-arrow" aria-hidden="true">&#8593;</span>
				<span>Back to top</span>
			</button>
		)
	}
</nav>

<script>
	const root = document.querySelector("[data-toc-root]");
	const navs = [...document.querySelectorAll<HTMLElement>("nav[data-toc]")];
	if (root && navs.length) {
		const heads = [
			...root.querySelectorAll<HTMLElement>("h2[id], h3[id], h4[id]"),
		];
		interface SubEntry {
			h3: HTMLElement;
			h4s: HTMLElement[];
		}
		const sections: { h2: HTMLElement; subs: SubEntry[] }[] = [];
		for (const h of heads) {
			if (h.tagName === "H2") sections.push({ h2: h, subs: [] });
			else if (h.tagName === "H3")
				sections.at(-1)?.subs.push({ h3: h, h4s: [] });
			else sections.at(-1)?.subs.at(-1)?.h4s.push(h);
		}

		if (sections.length === 0) {
			for (const nav of navs) nav.style.display = "none";
		} else {
			const reduceMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;
			const goTo = (h: HTMLElement) => (e: Event) => {
				e.preventDefault();
				h.scrollIntoView({
					behavior: reduceMotion ? "auto" : "smooth",
					block: "start",
				});
				history.pushState(null, "", `#${h.id}`);
			};

			// —— accordion state, two nesting levels ——
			// The current section (and, within it, the current subsection)
			// auto-expands; others collapse. Manual caret toggles override
			// that until the reader moves on.
			let current = 0;
			let currentSub = -1;
			let currentLeaf = -1;
			const m1Open = new Set<number>();
			const m1Closed = new Set<number>();
			const m2Open = new Set<string>();
			const m2Closed = new Set<string>();
			const expandedAt = (i: number) =>
				m1Open.has(i) || (i === current && !m1Closed.has(i));
			const expanded2At = (i: number, j: number) =>
				m2Open.has(`${i}:${j}`) ||
				(i === current && j === currentSub && !m2Closed.has(`${i}:${j}`));
			const clearM2For = (i: number, j?: number) => {
				for (const set of [m2Open, m2Closed]) {
					for (const key of [...set]) {
						if (j === undefined ? key.startsWith(`${i}:`) : key === `${i}:${j}`)
							set.delete(key);
					}
				}
			};

			interface SubRefs {
				li: HTMLElement;
				link: HTMLAnchorElement;
				caret?: HTMLButtonElement;
				wrap?: HTMLElement;
				leafLinks: HTMLAnchorElement[];
			}
			interface RailRefs {
				scroll: HTMLElement | null;
				items: HTMLElement[];
				rowLinks: HTMLAnchorElement[];
				carets: (HTMLButtonElement | undefined)[];
				subWraps: (HTMLElement | undefined)[];
				subs: SubRefs[][];
			}
			const rails: RailRefs[] = [];

			// Keep the active entry visible inside the rail's scroll box,
			// scrolling only the box (never the page) with minimal motion.
			// On expansion, prefer revealing the whole sub-list when it fits.
			// Delayed past the 250ms expand animation so we measure final
			// layout; skipped while the pointer is over the rail.
			let revealTimer: number | undefined;
			const scheduleReveal = () => {
				clearTimeout(revealTimer);
				revealTimer = window.setTimeout(() => {
					for (const r of rails) {
						const c = r.scroll;
						if (!c || c.scrollHeight <= c.clientHeight) continue;
						if (c.matches(":hover")) continue;
						const subRef =
							currentSub >= 0 ? r.subs[current]?.[currentSub] : undefined;
						const active =
							currentLeaf >= 0
								? subRef?.leafLinks[currentLeaf]
								: (subRef?.link ?? r.rowLinks[current]);
						if (!active) continue;
						const cRect = c.getBoundingClientRect();
						const rel = (el: HTMLElement) =>
							el.getBoundingClientRect().top - cRect.top + c.scrollTop;
						const ch = c.clientHeight;
						let st = c.scrollTop;
						// innermost expanded group wins for the fit-into-view pass
						const group =
							subRef && expanded2At(current, currentSub)
								? subRef.li
								: expandedAt(current)
									? r.items[current]
									: undefined;
						if (group && group.offsetHeight <= ch) {
							const gTop = rel(group);
							const gBottom = gTop + group.offsetHeight;
							if (gBottom > st + ch) st = gBottom - ch;
							if (gTop < st) st = gTop;
						}
						const aTop = rel(active);
						const aBottom = aTop + active.offsetHeight;
						const pad = 6;
						if (aTop < st + pad) st = aTop - pad;
						else if (aBottom > st + ch - pad) st = aBottom - ch + pad;
						if (Math.abs(st - c.scrollTop) > 1) {
							c.scrollTo({
								top: st,
								behavior: reduceMotion ? "auto" : "smooth",
							});
						}
					}
				}, 300);
			};

			const apply = () => {
				for (const r of rails) {
					sections.forEach((_, i) => {
						r.rowLinks[i]?.classList.toggle("active", i === current);
						const open = expandedAt(i);
						r.subWraps[i]?.classList.toggle("open", open);
						r.carets[i]?.classList.toggle("open", open);
						r.carets[i]?.setAttribute("aria-expanded", String(open));
						r.subs[i]?.forEach((sr, j) => {
							const subActive = i === current && j === currentSub;
							sr.link.classList.toggle("active", subActive);
							const open2 = expanded2At(i, j);
							sr.wrap?.classList.toggle("open", open2);
							sr.caret?.classList.toggle("open", open2);
							sr.caret?.setAttribute("aria-expanded", String(open2));
							sr.leafLinks.forEach((la, k) =>
								la.classList.toggle("active", subActive && k === currentLeaf),
							);
						});
					});
				}
			};

			const toggle = (i: number) => {
				if (expandedAt(i)) {
					if (m1Open.has(i)) m1Open.delete(i);
					else m1Closed.add(i);
				} else {
					m1Open.add(i);
					m1Closed.delete(i);
				}
				apply();
				scheduleReveal();
			};

			const toggle2 = (i: number, j: number) => {
				const key = `${i}:${j}`;
				if (expanded2At(i, j)) {
					if (m2Open.has(key)) m2Open.delete(key);
					else m2Closed.add(key);
				} else {
					m2Open.add(key);
					m2Closed.delete(key);
				}
				apply();
				scheduleReveal();
			};

			const caretSvg =
				'<svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5"/></svg>';

			for (const nav of navs) {
				const ul = nav.querySelector("ul");
				if (!ul) continue;

				if (nav.classList.contains("toc-inline")) {
					for (const s of sections) {
						const li = document.createElement("li");
						const a = document.createElement("a");
						a.href = `#${s.h2.id}`;
						a.textContent = s.h2.textContent ?? "";
						a.addEventListener("click", goTo(s.h2));
						li.append(a);
						ul.append(li);
					}
					continue;
				}

				const makeRow = (
					h: HTMLElement,
					onToggle?: () => void,
				): {
					row: HTMLElement;
					link: HTMLAnchorElement;
					caret?: HTMLButtonElement;
				} => {
					const row = document.createElement("div");
					row.className = "toc-row";
					const link = document.createElement("a");
					link.href = `#${h.id}`;
					link.textContent = h.textContent ?? "";
					link.addEventListener("click", goTo(h));
					row.append(link);
					let caret: HTMLButtonElement | undefined;
					if (onToggle) {
						caret = document.createElement("button");
						caret.className = "toc-caret";
						caret.type = "button";
						caret.setAttribute(
							"aria-label",
							`Toggle ${h.textContent} subsections`,
						);
						caret.innerHTML = caretSvg;
						caret.addEventListener("click", onToggle);
						row.append(caret);
					}
					return { row, link, caret };
				};

				const refs: RailRefs = {
					scroll: nav.querySelector(".toc-scroll"),
					items: [],
					rowLinks: [],
					carets: [],
					subWraps: [],
					subs: [],
				};
				sections.forEach((s, i) => {
					const li = document.createElement("li");
					li.className = "toc-section";
					const { row, link, caret } = makeRow(
						s.h2,
						s.subs.length ? () => toggle(i) : undefined,
					);
					refs.rowLinks.push(link);
					if (caret) refs.carets[i] = caret;
					li.append(row);

					const subRefsHere: SubRefs[] = [];
					if (s.subs.length) {
						const wrap = document.createElement("div");
						wrap.className = "toc-subwrap";
						const sub = document.createElement("ul");
						sub.className = "toc-sub";
						s.subs.forEach((se, j) => {
							const sli = document.createElement("li");
							const subRow = makeRow(
								se.h3,
								se.h4s.length ? () => toggle2(i, j) : undefined,
							);
							sli.append(subRow.row);
							const leafLinks: HTMLAnchorElement[] = [];
							let wrap2: HTMLElement | undefined;
							if (se.h4s.length) {
								wrap2 = document.createElement("div");
								wrap2.className = "toc-subwrap";
								const sub2 = document.createElement("ul");
								sub2.className = "toc-sub toc-sub2";
								for (const h4 of se.h4s) {
									const lli = document.createElement("li");
									const la = document.createElement("a");
									la.href = `#${h4.id}`;
									la.textContent = h4.textContent ?? "";
									la.addEventListener("click", goTo(h4));
									lli.append(la);
									sub2.append(lli);
									leafLinks.push(la);
								}
								wrap2.append(sub2);
								sli.append(wrap2);
							}
							sub.append(sli);
							subRefsHere.push({
								li: sli,
								link: subRow.link,
								caret: subRow.caret,
								wrap: wrap2,
								leafLinks,
							});
						});
						wrap.append(sub);
						li.append(wrap);
						refs.subWraps[i] = wrap;
					}
					refs.subs.push(subRefsHere);
					refs.items.push(li);
					ul.append(li);
				});
				rails.push(refs);
			}

			// —— scrollspy + Top link visibility ——
			const tops = [
				...document.querySelectorAll<HTMLElement>("[data-toc-top]"),
			];
			for (const t of tops) {
				t.addEventListener("click", () => {
					window.scrollTo({
						top: 0,
						behavior: reduceMotion ? "auto" : "smooth",
					});
				});
			}

			const THRESH = 130;
			const postH1 = document.querySelector<HTMLElement>(".post-header h1");
			let ticking = false;
			const update = () => {
				ticking = false;
				let cur = 0;
				sections.forEach((s, i) => {
					if (s.h2.getBoundingClientRect().top < THRESH) cur = i;
				});
				let sub = -1;
				sections[cur].subs.forEach((se, j) => {
					if (se.h3.getBoundingClientRect().top < THRESH) sub = j;
				});
				let leaf = -1;
				if (sub >= 0) {
					sections[cur].subs[sub].h4s.forEach((h, k) => {
						if (h.getBoundingClientRect().top < THRESH) leaf = k;
					});
				}
				const changed =
					cur !== current || sub !== currentSub || leaf !== currentLeaf;
				if (cur !== current) {
					m1Open.delete(current);
					m1Closed.delete(current);
					clearM2For(current);
					current = cur;
				} else if (sub !== currentSub && currentSub >= 0) {
					clearM2For(current, currentSub);
				}
				currentSub = sub;
				currentLeaf = leaf;
				apply();
				if (changed) scheduleReveal();
				// appear in step with the post title merging into the header
				const showTop = postH1
					? postH1.getBoundingClientRect().bottom < 60
					: window.scrollY > window.innerHeight;
				for (const t of tops) {
					t.classList.toggle("visible", showTop);
				}
			};
			update();
			window.addEventListener(
				"scroll",
				() => {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(update);
					}
				},
				{ passive: true },
			);
		}
	}
</script>

<style is:global>
	[data-toc-root] :is(h2, h3, h4)[id] {
		scroll-margin-top: 80px;
	}
</style>

<style>
	.toc-title {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.52rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--date-color);
		margin-bottom: 0.5rem;
	}

	.toc :global(ul) {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.toc :global(li) {
		margin: 0;
	}

	.toc :global(a) {
		display: block;
		padding: 0.2rem 0.5rem 0.2rem 0.6rem;
		color: var(--date-color);
		text-decoration: none;
		border-radius: 0 4px 4px 0;
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	.toc :global(a:hover) {
		color: var(--heading-color);
		background: var(--code-background);
	}

	/* metric-stable active state: color and background only, never a
	 * weight change (bolding reflows and can rewrap long entries) */
	.toc :global(a.active) {
		color: var(--heading-color);
		background: var(--code-background);
	}

	/* —— sticky left rail (lives in the post-shell grid column) ——
	 * Fixed height with the heading list scrolling inside it, so the
	 * Top control pins to the bottom regardless of list length. */
	.toc-rail {
		position: sticky;
		top: 4rem;
		height: calc(100vh - 4rem - 1.25rem);
		display: flex;
		flex-direction: column;
		font-size: 0.68rem;
		line-height: 1.5;
	}

	.toc-rail .toc-scroll {
		overflow-y: auto;
		min-height: 0;
		margin-bottom: 1rem;
		scrollbar-width: thin;
		scrollbar-color: var(--border-color) transparent;
	}

	.toc-rail :global(.toc-row) {
		display: flex;
		align-items: center;
		border-left: 2px solid var(--border-color);
	}

	.toc-rail :global(.toc-row > a) {
		flex: 1;
		min-width: 0;
	}

	.toc-rail :global(.toc-row:has(> a.active)) {
		border-left-color: var(--article-link-hover-border);
	}

	.toc-rail :global(.toc-caret) {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.25rem;
		height: 1.25rem;
		margin-right: 0.1rem;
		border: 0;
		border-radius: 4px;
		background: transparent;
		color: var(--date-color);
		cursor: pointer;
	}

	.toc-rail :global(.toc-caret:hover) {
		color: var(--heading-color);
		background: var(--code-background);
	}

	.toc-rail :global(.toc-caret svg) {
		transition: transform 0.2s ease;
	}

	.toc-rail :global(.toc-caret.open svg) {
		transform: rotate(90deg);
	}

	.toc-rail :global(.toc-subwrap) {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.25s ease;
	}

	.toc-rail :global(.toc-subwrap.open) {
		grid-template-rows: 1fr;
	}

	.toc-rail :global(.toc-sub) {
		overflow: hidden;
		min-height: 0;
		border-left: 2px solid var(--border-color);
	}

	.toc-rail :global(.toc-sub a) {
		padding-left: 1.4rem;
		font-size: 0.94em;
	}

	/* nested rows sit inside the sub-list's spine; no second border */
	.toc-rail :global(.toc-sub .toc-row),
	.toc-rail :global(.toc-sub .toc-sub) {
		border-left: none;
	}

	.toc-rail :global(.toc-sub2 a) {
		padding-left: 2.2rem;
		font-size: 0.9em;
	}

	.toc-top {
		flex: none;
		align-self: flex-start;
		display: flex;
		/* svg baseline = its bottom edge, so the cropped arrow sits
		 * exactly on the text baseline */
		align-items: baseline;
		gap: 0.4rem;
		margin-top: auto;
		padding: 0.34rem 0.55rem 0.26rem;
		line-height: 1;
		border: 1px solid var(--border-color);
		border-radius: 6px;
		background: transparent;
		color: var(--date-color);
		font-family: var(--font-mono);
		font-size: 0.5rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.2s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.toc-top-arrow {
		font-size: 0.55rem;
		line-height: 1;
	}

	.toc-top.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.toc-top:hover {
		color: var(--heading-color);
		border-color: var(--article-link-hover-border);
	}

	@media (max-width: 1019px) {
		.toc-rail {
			display: none;
		}
	}

	/* —— in-flow contents block —— */
	.toc-inline {
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 0.7rem 0.9rem;
		margin: 1.2rem 0 1.6rem;
		font-size: 0.66rem;
		line-height: 1.5;
	}

	.toc-inline :global(a) {
		border-left: 2px solid var(--border-color);
		border-radius: 0 4px 4px 0;
	}

	@media (min-width: 1020px) {
		.toc-inline {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.toc-rail :global(.toc-subwrap),
		.toc-rail :global(.toc-caret svg) {
			transition: none;
		}
	}
</style>
