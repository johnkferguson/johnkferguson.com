---
// Section navigation, rendered at build time from the page's headings
// (depths 2-4, stepwise nesting guaranteed by the heading-structure
// test). Two variants:
//   <TableOfContents headings={...} />         sticky left rail: nested
//       accordion with carets, three-level scrollspy, Top link
//   <TableOfContents inline headings={...} />  collapsed <details>
//       Contents block (flat h2 list), shown when the rail does not fit
//
// The client script attaches behavior only (scrollspy, accordion,
// auto-scroll, Top, smooth scroll); the full list exists without JS, and
// a noscript style expands every rail sub-list for JS-less readers.
import type { MarkdownHeading } from "astro";

interface LabEntry {
	title: string;
	id: string;
	/** index into `headings` of the heading whose territory the lab sits in */
	afterHeading: number;
}
interface Props {
	inline?: boolean;
	headings?: MarkdownHeading[];
	labs?: LabEntry[];
}
const { inline = false, headings = [], labs = [] } = Astro.props;

interface SubEntry {
	slug: string;
	text: string;
	leaves: { slug: string; text: string }[];
	labs: LabEntry[];
}
interface Section {
	slug: string;
	text: string;
	subs: SubEntry[];
	labs: LabEntry[];
}
const sections: Section[] = [];
headings.forEach((h, i) => {
	if (h.depth === 2)
		sections.push({ slug: h.slug, text: h.text, subs: [], labs: [] });
	else if (h.depth === 3)
		sections
			.at(-1)
			?.subs.push({ slug: h.slug, text: h.text, leaves: [], labs: [] });
	else if (h.depth === 4)
		sections.at(-1)?.subs.at(-1)?.leaves.push({ slug: h.slug, text: h.text });
	/* labs attach to the innermost entry the TOC keeps for their heading:
	 * the section itself for h2, the current subsection for h3/h4 */
	const s = sections.at(-1);
	if (!s) return;
	for (const lab of labs.filter((l) => l.afterHeading === i)) {
		(h.depth >= 3 ? (s.subs.at(-1)?.labs ?? s.labs) : s.labs).push(lab);
	}
});

const caretSvg =
	'<svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5"/></svg>';
/* flask-conical with green liquid (#5a9367, John's pick): the fill and
 * green surface line paint first, the full currentColor outline paints
 * last so the flask border stays whole where the surface line's round
 * caps would otherwise cut it */
const beakerSvg =
	'<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 16h10l2.28 4.55a1 1 0 0 1-.9 1.45H5.62a1 1 0 0 1-.9-1.45Z" stroke="none" fill="#5a9367"/><path d="M7 16h10" stroke="#5a9367"/><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/></svg>';
---

{
	inline && sections.length > 0 && (
		<nav class="toc toc-inline" data-toc aria-label="Sections">
			<details>
				<summary class="micro-label">
					<span class="toc-inline-caret" set:html={caretSvg} />
					Contents
				</summary>
				<ul>
					{sections.map((s) => (
						<>
							<li>
								<a href={`#${s.slug}`}>{s.text}</a>
							</li>
							{/* labs flat under their section; s.labs precede sub labs
							 * in document order by construction */}
							{[...s.labs, ...s.subs.flatMap((sub) => sub.labs)].map(
								(lab) => (
									<li>
										<a class="toc-lab" href={`#${lab.id}`}>
											<span class="toc-beaker" set:html={beakerSvg} />
											<span>{lab.title}</span>
										</a>
									</li>
								),
							)}
						</>
					))}
				</ul>
			</details>
		</nav>
	)
}
{
	!inline && sections.length > 0 && (
		<nav class="toc toc-rail" data-toc aria-label="Sections">
			<div class="toc-panel">
				<div class="toc-scroll">
					<span class="toc-title micro-label">Contents</span>
					<ul>
						{sections.map((s) => (
								<li class="toc-section">
									<div class="toc-row">
										<a href={`#${s.slug}`}>{s.text}</a>
										{(s.subs.length > 0 || s.labs.length > 0) && (
											<button
												class="toc-caret"
												type="button"
												aria-label={`Toggle ${s.text} subsections`}
												aria-expanded="false"
												set:html={caretSvg}
											/>
										)}
									</div>
									{(s.subs.length > 0 || s.labs.length > 0) && (
										<div class="toc-subwrap">
											<ul class="toc-sub">
												{s.subs.map((sub) => (
													<li>
														<div class="toc-row">
															<a href={`#${sub.slug}`}>{sub.text}</a>
															{(sub.leaves.length > 0 ||
																sub.labs.length > 0) && (
																<button
																	class="toc-caret"
																	type="button"
																	aria-label={`Toggle ${sub.text} subsections`}
																	aria-expanded="false"
																	set:html={caretSvg}
																/>
															)}
														</div>
														{(sub.leaves.length > 0 ||
															sub.labs.length > 0) && (
															<div class="toc-subwrap">
																<ul class="toc-sub toc-sub2">
																	{sub.leaves.map((leaf) => (
																		<li>
																			<a href={`#${leaf.slug}`}>{leaf.text}</a>
																		</li>
																	))}
																	{sub.labs.map((lab) => (
																		<li>
																			<a class="toc-lab" href={`#${lab.id}`}>
																				<span
																					class="toc-beaker"
																					set:html={beakerSvg}
																				/>
																				<span>{lab.title}</span>
																			</a>
																		</li>
																	))}
																</ul>
															</div>
														)}
													</li>
												))}
												{s.labs.map((lab) => (
													<li>
														<div class="toc-row">
															<a class="toc-lab" href={`#${lab.id}`}>
																<span
																	class="toc-beaker"
																	set:html={beakerSvg}
																/>
																<span>{lab.title}</span>
															</a>
														</div>
													</li>
												))}
											</ul>
										</div>
									)}
								</li>
							))}
					</ul>
				</div>
			</div>
		</nav>
	)
}
{
	/* Sibling of the nav, not a child: the rail hugs its list while the
	 * button lives at the END of the .post-rail flex column and sticks to
	 * the viewport bottom on its own. When the page bottom arrives, only
	 * the button rides up with the column's end (footer-dodging); the
	 * rail itself never moves.
	 *
	 * Rendered whether or not there are sections, so a post with no
	 * headings is still an ordinary post: same Top control, same place,
	 * just no list above it. Gating this on sections.length left such a
	 * post with no rail control at all, falling back to the floating
	 * button, which at >=1020 lands on the footer's outbound links. */
	!inline && (
		<button class="toc-top micro-label" data-toc-top type="button">
			<span class="toc-top-arrow" aria-hidden="true">
				&#8593;
			</span>
			<span>Back to top</span>
		</button>
	)
}

<noscript>
	<style is:global>
		/* without JS the accordion cannot open; show everything */
		.toc-rail .toc-subwrap {
			grid-template-rows: 1fr;
		}
	</style>
</noscript>

<script>
	const rail = document.querySelector<HTMLElement>("nav.toc-rail");
	const inlineNav = document.querySelector<HTMLElement>("nav.toc-inline");
	const root = document.querySelector("[data-toc-root]");

	const reduceMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;
	const goTo = (el: HTMLElement) => (e: Event) => {
		e.preventDefault();
		el.scrollIntoView({
			behavior: reduceMotion ? "auto" : "smooth",
			block: "start",
		});
		history.pushState(null, "", `#${el.id}`);
	};

	// —— inline variant: server-rendered list; JS adds smooth scroll.
	// The open/closed state is the reader's; navigation never changes it. ——
	if (inlineNav) {
		for (const a of inlineNav.querySelectorAll<HTMLAnchorElement>("a")) {
			const target = document.getElementById(
				decodeURIComponent(a.hash.slice(1)),
			);
			if (target) a.addEventListener("click", goTo(target));
		}
	}

	/* —— Top chip ——
	 * Wired independently of the rail. The chip is a SIBLING of the nav,
	 * and a post with no headings renders the chip but no nav; keeping
	 * this inside the rail's `if (rail && root)` guard left such a post
	 * with a chip that never faded in. */
	const tops = [...document.querySelectorAll<HTMLElement>("[data-toc-top]")];
	if (tops.length) {
		const postH1Top = document.querySelector<HTMLElement>(".post-header h1");
		const siteFooter = document.querySelector<HTMLElement>(".site-footer");

		for (const t of tops) {
			t.addEventListener("click", () => {
				window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
			});
		}

		let chipTicking = false;
		const updateChips = () => {
			chipTicking = false;
			// appear in step with the post title merging into the header
			const showTop = postH1Top
				? postH1Top.getBoundingClientRect().bottom < 60
				: window.scrollY > window.innerHeight;
			/* The chip's resting edge is derived, not measured: it is stuck
			 * at bottom:calc(var(--footer-h) + 1px), so its bottom is the
			 * viewport bottom less the footer band and that pixel. The band
			 * comes from the footer's OWN rect, which is already being read
			 * here for its top: --footer-h is a rem token, and parsing it
			 * as a number yields 1.45 rather than 29px, which landed the
			 * chip some 28px early, squared off while still floating. */
			const footerBox = siteFooter?.getBoundingClientRect();
			const footerTop = footerBox?.top ?? Number.POSITIVE_INFINITY;
			const chipBottom = window.innerHeight - (footerBox?.height ?? 0) - 1;
			const landed = showTop && footerTop <= chipBottom + 1.5;
			for (const t of tops) {
				t.classList.toggle("visible", showTop);
				t.classList.toggle("landed", landed);
			}
		};
		const onChipScroll = () => {
			if (!chipTicking) {
				chipTicking = true;
				requestAnimationFrame(updateChips);
			}
		};
		const chipWide = window.matchMedia("(min-width: 1020px)");
		const armChips = () => {
			if (chipWide.matches) {
				updateChips();
				window.addEventListener("scroll", onChipScroll, { passive: true });
				/* `landed` encodes a geometric coincidence between the chip
				 * and the footer, which a viewport change invalidates at
				 * once: without this, resizing after landing leaves a
				 * squared-off, open-bottomed chip floating clear of the
				 * hairline. Shares the rAF guard, so a drag coalesces to
				 * one measurement per frame. */
				window.addEventListener("resize", onChipScroll, { passive: true });
			} else {
				window.removeEventListener("scroll", onChipScroll);
				window.removeEventListener("resize", onChipScroll);
			}
		};
		armChips();
		chipWide.addEventListener("change", armChips);
	}

	// —— rail variant: attach behavior to the server-rendered tree ——
	if (rail && root) {
		interface SubRef {
			li: HTMLElement;
			link: HTMLAnchorElement;
			caret: HTMLButtonElement | null;
			wrap: HTMLElement | null;
			leafLinks: HTMLAnchorElement[];
			h3: HTMLElement | null;
			h4s: HTMLElement[];
		}
		interface SectionRef {
			li: HTMLElement;
			link: HTMLAnchorElement;
			caret: HTMLButtonElement | null;
			wrap: HTMLElement | null;
			subs: SubRef[];
			h2: HTMLElement | null;
		}

		const byHash = (a: HTMLAnchorElement) =>
			document.getElementById(decodeURIComponent(a.hash.slice(1)));

		const scroll = rail.querySelector<HTMLElement>(".toc-scroll");
		const sections: SectionRef[] = [
			...rail.querySelectorAll<HTMLElement>(".toc-scroll > ul > li"),
		].map((li) => {
			const link = li.querySelector<HTMLAnchorElement>(
				":scope > .toc-row > a",
			) as HTMLAnchorElement;
			const subs: SubRef[] = [
				...li.querySelectorAll<HTMLElement>(":scope > .toc-subwrap > ul > li"),
			].map((sli) => {
				const sLink = sli.querySelector<HTMLAnchorElement>(
					":scope > .toc-row > a",
				) as HTMLAnchorElement;
				const leafLinks = [
					...sli.querySelectorAll<HTMLAnchorElement>(
						":scope > .toc-subwrap a",
					),
				];
				return {
					li: sli,
					link: sLink,
					caret: sli.querySelector<HTMLButtonElement>(
						":scope > .toc-row > .toc-caret",
					),
					wrap: sli.querySelector<HTMLElement>(":scope > .toc-subwrap"),
					leafLinks,
					h3: byHash(sLink),
					h4s: leafLinks
						.map(byHash)
						.filter((el): el is HTMLElement => el != null),
				};
			});
			return {
				li,
				link,
				caret: li.querySelector<HTMLButtonElement>(
					":scope > .toc-row > .toc-caret",
				),
				wrap: li.querySelector<HTMLElement>(":scope > .toc-subwrap"),
				subs,
				h2: byHash(link),
			};
		});

		// navigation clicks (smooth scroll instead of native jump)
		for (const s of sections) {
			if (s.h2) s.link.addEventListener("click", goTo(s.h2));
			for (const sub of s.subs) {
				if (sub.h3) sub.link.addEventListener("click", goTo(sub.h3));
				sub.leafLinks.forEach((la, k) => {
					const h4 = sub.h4s[k];
					if (h4) la.addEventListener("click", goTo(h4));
				});
			}
		}

		// —— accordion state, two nesting levels ——
		// The current section (and, within it, the current subsection)
		// auto-expands; others collapse. Manual caret toggles override
		// that until the reader moves on.
		let current = -1;
		let currentSub = -1;
		let currentLeaf = -1;
		const m1Open = new Set<number>();
		const m1Closed = new Set<number>();
		const m2Open = new Set<string>();
		const m2Closed = new Set<string>();
		const expandedAt = (i: number) =>
			m1Open.has(i) || (i === current && !m1Closed.has(i));
		const expanded2At = (i: number, j: number) =>
			m2Open.has(`${i}:${j}`) ||
			(i === current && j === currentSub && !m2Closed.has(`${i}:${j}`));
		const clearM2For = (i: number, j?: number) => {
			for (const set of [m2Open, m2Closed]) {
				for (const key of [...set]) {
					if (j === undefined ? key.startsWith(`${i}:`) : key === `${i}:${j}`)
						set.delete(key);
				}
			}
		};

		const mark = (el: HTMLElement, on: boolean) => {
			el.classList.toggle("active", on);
			if (on) el.setAttribute("aria-current", "true");
			else el.removeAttribute("aria-current");
		};
		const apply = () => {
			sections.forEach((s, i) => {
				mark(s.link, i === current);
				const open = expandedAt(i);
				s.wrap?.classList.toggle("open", open);
				s.caret?.classList.toggle("open", open);
				s.caret?.setAttribute("aria-expanded", String(open));
				s.subs.forEach((sub, j) => {
					const subActive = i === current && j === currentSub;
					mark(sub.link, subActive);
					const open2 = expanded2At(i, j);
					sub.wrap?.classList.toggle("open", open2);
					sub.caret?.classList.toggle("open", open2);
					sub.caret?.setAttribute("aria-expanded", String(open2));
					sub.leafLinks.forEach((la, k) =>
						mark(la, subActive && k === currentLeaf),
					);
				});
			});
		};

		// Keep the active entry visible inside the rail's scroll box,
		// scrolling only the box (never the page) with minimal motion.
		// On expansion, prefer revealing the whole sub-list when it fits.
		// Delayed past the 250ms expand animation so we measure final
		// layout; skipped while the pointer is over the rail.
		let revealTimer: number | undefined;
		const scheduleReveal = () => {
			clearTimeout(revealTimer);
			revealTimer = window.setTimeout(() => {
				const c = scroll;
				if (!c || c.scrollHeight <= c.clientHeight) return;
				if (c.matches(":hover")) return;
				if (current < 0) return;
				const subRef = currentSub >= 0 ? sections[current]?.subs[currentSub] : undefined;
				const active =
					currentLeaf >= 0
						? subRef?.leafLinks[currentLeaf]
						: (subRef?.link ?? sections[current]?.link);
				if (!active) return;
				const cRect = c.getBoundingClientRect();
				const rel = (el: HTMLElement) =>
					el.getBoundingClientRect().top - cRect.top + c.scrollTop;
				const ch = c.clientHeight;
				let st = c.scrollTop;
				// innermost expanded group wins for the fit-into-view pass
				const group =
					subRef && expanded2At(current, currentSub)
						? subRef.li
						: expandedAt(current)
							? sections[current]?.li
							: undefined;
				if (group && group.offsetHeight <= ch) {
					const gTop = rel(group);
					const gBottom = gTop + group.offsetHeight;
					if (gBottom > st + ch) st = gBottom - ch;
					if (gTop < st) st = gTop;
				}
				const aTop = rel(active);
				const aBottom = aTop + active.offsetHeight;
				const pad = 6;
				if (aTop < st + pad) st = aTop - pad;
				else if (aBottom > st + ch - pad) st = aBottom - ch + pad;
				if (Math.abs(st - c.scrollTop) > 1) {
					c.scrollTo({ top: st, behavior: reduceMotion ? "auto" : "smooth" });
				}
			}, 300);
		};

		const toggle = (i: number) => {
			if (expandedAt(i)) {
				if (m1Open.has(i)) m1Open.delete(i);
				else m1Closed.add(i);
			} else {
				m1Open.add(i);
				m1Closed.delete(i);
			}
			apply();
			scheduleReveal();
		};
		const toggle2 = (i: number, j: number) => {
			const key = `${i}:${j}`;
			if (expanded2At(i, j)) {
				if (m2Open.has(key)) m2Open.delete(key);
				else m2Closed.add(key);
			} else {
				m2Open.add(key);
				m2Closed.delete(key);
			}
			apply();
			scheduleReveal();
		};
		sections.forEach((s, i) => {
			s.caret?.addEventListener("click", () => toggle(i));
			s.subs.forEach((sub, j) => {
				sub.caret?.addEventListener("click", () => toggle2(i, j));
			});
		});

		// —— scrollspy ——
		const THRESH = 130;
		const postH1 = document.querySelector<HTMLElement>(".post-header h1");
		let ticking = false;
		const update = () => {
			ticking = false;
			/* before the first h2 is reached (reading the lede), nothing
			 * is current and nothing highlights */
			let cur = -1;
			sections.forEach((s, i) => {
				if (s.h2 && s.h2.getBoundingClientRect().top < THRESH) cur = i;
			});
			let sub = -1;
			let leaf = -1;
			/* a final section shorter than the viewport can never cross the
			 * threshold; at the page bottom, snap to the very end */
			const atBottom =
				window.innerHeight + window.scrollY >=
				document.documentElement.scrollHeight - 2;
			if (atBottom && sections.length) {
				cur = sections.length - 1;
				sub = sections[cur].subs.length - 1;
				leaf = sub >= 0 ? sections[cur].subs[sub].h4s.length - 1 : -1;
			} else if (cur >= 0) {
				sections[cur].subs.forEach((se, j) => {
					if (se.h3 && se.h3.getBoundingClientRect().top < THRESH) sub = j;
				});
				if (sub >= 0) {
					sections[cur].subs[sub].h4s.forEach((h, k) => {
						if (h.getBoundingClientRect().top < THRESH) leaf = k;
					});
				}
			}
			const changed =
				cur !== current || sub !== currentSub || leaf !== currentLeaf;
			if (cur !== current) {
				m1Open.delete(current);
				m1Closed.delete(current);
				clearM2For(current);
				current = cur;
			} else if (sub !== currentSub && currentSub >= 0) {
				clearM2For(current, currentSub);
			}
			currentSub = sub;
			currentLeaf = leaf;
			/* class churn only when the position actually moved */
			if (changed) {
				apply();
				scheduleReveal();
			}
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};
		/* the rail only exists at >=1020px; below that, skip the per-frame
		 * rect measurements entirely (weakest CPUs are the narrow ones) */
		const wide = window.matchMedia("(min-width: 1020px)");
		const arm = () => {
			if (wide.matches) {
				update();
				window.addEventListener("scroll", onScroll, { passive: true });
			} else {
				window.removeEventListener("scroll", onScroll);
			}
		};
		arm();
		wide.addEventListener("change", arm);
	}
</script>

<style is:global>
	[data-toc-root] :is(h2, h3, h4)[id],
	[data-toc-root] .labwrap[id] {
		scroll-margin-top: var(--anchor-offset);
	}
</style>

<style>
	.toc-title {
		display: block;
		font-size: 0.52rem;
		letter-spacing: 0.14em;
		margin-bottom: 0.5rem;
	}

	.toc :global(ul) {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.toc :global(li) {
		margin: 0;
	}

	.toc :global(a) {
		display: block;
		padding: 0.2rem 0.5rem 0.2rem 0.6rem;
		color: var(--date-color);
		text-decoration: none;
		border-radius: 0 4px 4px 0;
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	.toc :global(a:hover) {
		color: var(--heading-color);
		background: var(--code-background);
	}

	/* metric-stable active state: color and background only, never a
	 * weight change (bolding reflows and can rewrap long entries) */
	.toc :global(a.active) {
		color: var(--heading-color);
		background: var(--code-background);
	}

	/* lab entries: beaker icon riding the first text line */
	.toc :global(a.toc-lab) {
		display: flex;
		gap: 0.25rem;
	}

	.toc :global(.toc-beaker) {
		display: flex;
