---
// Section navigation, rendered at build time from the page's headings
// (depths 2-4, stepwise nesting guaranteed by the heading-structure
// test). Two variants:
//   <TableOfContents headings={...} />  sticky left rail: nested
//       accordion with carets, three-level scrollspy, Top link
//   <TableOfContents inline />          in-flow Contents block (flat h2
//       list, populated client-side from the article), shown when the
//       rail does not fit
//
// The client script attaches behavior only (scrollspy, accordion,
// auto-scroll, Top); the full list exists without JS, and a noscript
// style expands every sub-list for JS-less readers.
import type { MarkdownHeading } from "astro";

interface Props {
	inline?: boolean;
	headings?: MarkdownHeading[];
}
const { inline = false, headings = [] } = Astro.props;

interface SubEntry {
	slug: string;
	text: string;
	leaves: { slug: string; text: string }[];
}
interface Section {
	slug: string;
	text: string;
	subs: SubEntry[];
}
const sections: Section[] = [];
for (const h of headings) {
	if (h.depth === 2) sections.push({ slug: h.slug, text: h.text, subs: [] });
	else if (h.depth === 3)
		sections.at(-1)?.subs.push({ slug: h.slug, text: h.text, leaves: [] });
	else if (h.depth === 4)
		sections.at(-1)?.subs.at(-1)?.leaves.push({ slug: h.slug, text: h.text });
}

const caretSvg =
	'<svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5"/></svg>';
---

{
	(inline || sections.length > 0) && (
		<nav
			class={inline ? "toc toc-inline" : "toc toc-rail"}
			data-toc
			aria-label="Sections"
		>
			<div class="toc-panel">
				<div class="toc-scroll">
					<span class="toc-title micro-label">Contents</span>
					<ul>
						{!inline &&
							sections.map((s) => (
								<li class="toc-section">
									<div class="toc-row">
										<a href={`#${s.slug}`}>{s.text}</a>
										{s.subs.length > 0 && (
											<button
												class="toc-caret"
												type="button"
												aria-label={`Toggle ${s.text} subsections`}
												aria-expanded="false"
												set:html={caretSvg}
											/>
										)}
									</div>
									{s.subs.length > 0 && (
										<div class="toc-subwrap">
											<ul class="toc-sub">
												{s.subs.map((sub) => (
													<li>
														<div class="toc-row">
															<a href={`#${sub.slug}`}>{sub.text}</a>
															{sub.leaves.length > 0 && (
																<button
																	class="toc-caret"
																	type="button"
																	aria-label={`Toggle ${sub.text} subsections`}
																	aria-expanded="false"
																	set:html={caretSvg}
																/>
															)}
														</div>
														{sub.leaves.length > 0 && (
															<div class="toc-subwrap">
																<ul class="toc-sub toc-sub2">
																	{sub.leaves.map((leaf) => (
																		<li>
																			<a href={`#${leaf.slug}`}>{leaf.text}</a>
																		</li>
																	))}
																</ul>
															</div>
														)}
													</li>
												))}
											</ul>
										</div>
									)}
								</li>
							))}
					</ul>
				</div>
			</div>
		</nav>
	)
}
{
	/* Sibling of the nav, not a child: the rail hugs its list while the
	 * button lives at the END of the .post-rail flex column and sticks to
	 * the viewport bottom on its own. When the page bottom arrives, only
	 * the button rides up with the column's end (footer-dodging); the
	 * rail itself never moves. */
	!inline && sections.length > 0 && (
		<button class="toc-top micro-label" data-toc-top type="button">
			<span class="toc-top-arrow" aria-hidden="true">
				&#8593;
			</span>
			<span>Back to top</span>
		</button>
	)
}

<noscript>
	<style is:global>
		/* without JS the accordion cannot open; show everything */
		.toc-rail .toc-subwrap {
			grid-template-rows: 1fr;
		}
	</style>
</noscript>

<script>
	const rail = document.querySelector<HTMLElement>("nav.toc-rail");
	const inlineNav = document.querySelector<HTMLElement>("nav.toc-inline");
	const root = document.querySelector("[data-toc-root]");

	const reduceMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;
	const goTo = (el: HTMLElement) => (e: Event) => {
		e.preventDefault();
		el.scrollIntoView({
			behavior: reduceMotion ? "auto" : "smooth",
			block: "start",
		});
		history.pushState(null, "", `#${el.id}`);
	};

	// —— inline variant: flat h2 list, populated from the article ——
	if (inlineNav && root) {
		const ul = inlineNav.querySelector("ul");
		const h2s = [...root.querySelectorAll<HTMLElement>("h2[id]")];
		if (ul && h2s.length) {
			for (const h of h2s) {
				const li = document.createElement("li");
				const a = document.createElement("a");
				a.href = `#${h.id}`;
				a.textContent = h.textContent ?? "";
				a.addEventListener("click", goTo(h));
				li.append(a);
				ul.append(li);
			}
		} else {
			inlineNav.style.display = "none";
		}
	}

	// —— rail variant: attach behavior to the server-rendered tree ——
	if (rail && root) {
		interface SubRef {
			li: HTMLElement;
			link: HTMLAnchorElement;
			caret: HTMLButtonElement | null;
			wrap: HTMLElement | null;
			leafLinks: HTMLAnchorElement[];
			h3: HTMLElement | null;
			h4s: HTMLElement[];
		}
		interface SectionRef {
			li: HTMLElement;
			link: HTMLAnchorElement;
			caret: HTMLButtonElement | null;
			wrap: HTMLElement | null;
			subs: SubRef[];
			h2: HTMLElement | null;
		}

		const byHash = (a: HTMLAnchorElement) =>
			document.getElementById(decodeURIComponent(a.hash.slice(1)));

		const scroll = rail.querySelector<HTMLElement>(".toc-scroll");
		const sections: SectionRef[] = [
			...rail.querySelectorAll<HTMLElement>(".toc-scroll > ul > li"),
		].map((li) => {
			const link = li.querySelector<HTMLAnchorElement>(
				":scope > .toc-row > a",
			) as HTMLAnchorElement;
			const subs: SubRef[] = [
				...li.querySelectorAll<HTMLElement>(":scope > .toc-subwrap > ul > li"),
			].map((sli) => {
				const sLink = sli.querySelector<HTMLAnchorElement>(
					":scope > .toc-row > a",
				) as HTMLAnchorElement;
				const leafLinks = [
					...sli.querySelectorAll<HTMLAnchorElement>(
						":scope > .toc-subwrap a",
					),
				];
				return {
					li: sli,
					link: sLink,
					caret: sli.querySelector<HTMLButtonElement>(
						":scope > .toc-row > .toc-caret",
					),
					wrap: sli.querySelector<HTMLElement>(":scope > .toc-subwrap"),
					leafLinks,
					h3: byHash(sLink),
					h4s: leafLinks
						.map(byHash)
						.filter((el): el is HTMLElement => el != null),
				};
			});
			return {
				li,
				link,
				caret: li.querySelector<HTMLButtonElement>(
					":scope > .toc-row > .toc-caret",
				),
				wrap: li.querySelector<HTMLElement>(":scope > .toc-subwrap"),
				subs,
				h2: byHash(link),
			};
		});

		// navigation clicks (smooth scroll instead of native jump)
		for (const s of sections) {
			if (s.h2) s.link.addEventListener("click", goTo(s.h2));
			for (const sub of s.subs) {
				if (sub.h3) sub.link.addEventListener("click", goTo(sub.h3));
				sub.leafLinks.forEach((la, k) => {
					const h4 = sub.h4s[k];
					if (h4) la.addEventListener("click", goTo(h4));
				});
			}
		}

		// —— accordion state, two nesting levels ——
		// The current section (and, within it, the current subsection)
		// auto-expands; others collapse. Manual caret toggles override
		// that until the reader moves on.
		let current = -1;
		let currentSub = -1;
		let currentLeaf = -1;
		const m1Open = new Set<number>();
		const m1Closed = new Set<number>();
		const m2Open = new Set<string>();
		const m2Closed = new Set<string>();
		const expandedAt = (i: number) =>
			m1Open.has(i) || (i === current && !m1Closed.has(i));
		const expanded2At = (i: number, j: number) =>
			m2Open.has(`${i}:${j}`) ||
			(i === current && j === currentSub && !m2Closed.has(`${i}:${j}`));
		const clearM2For = (i: number, j?: number) => {
			for (const set of [m2Open, m2Closed]) {
				for (const key of [...set]) {
					if (j === undefined ? key.startsWith(`${i}:`) : key === `${i}:${j}`)
						set.delete(key);
				}
			}
		};

		const mark = (el: HTMLElement, on: boolean) => {
			el.classList.toggle("active", on);
			if (on) el.setAttribute("aria-current", "true");
			else el.removeAttribute("aria-current");
		};
		const apply = () => {
			sections.forEach((s, i) => {
				mark(s.link, i === current);
				const open = expandedAt(i);
				s.wrap?.classList.toggle("open", open);
				s.caret?.classList.toggle("open", open);
				s.caret?.setAttribute("aria-expanded", String(open));
				s.subs.forEach((sub, j) => {
					const subActive = i === current && j === currentSub;
					mark(sub.link, subActive);
					const open2 = expanded2At(i, j);
					sub.wrap?.classList.toggle("open", open2);
					sub.caret?.classList.toggle("open", open2);
					sub.caret?.setAttribute("aria-expanded", String(open2));
					sub.leafLinks.forEach((la, k) =>
						mark(la, subActive && k === currentLeaf),
					);
				});
			});
		};

		// Keep the active entry visible inside the rail's scroll box,
		// scrolling only the box (never the page) with minimal motion.
		// On expansion, prefer revealing the whole sub-list when it fits.
		// Delayed past the 250ms expand animation so we measure final
		// layout; skipped while the pointer is over the rail.
		let revealTimer: number | undefined;
		const scheduleReveal = () => {
			clearTimeout(revealTimer);
			revealTimer = window.setTimeout(() => {
				const c = scroll;
				if (!c || c.scrollHeight <= c.clientHeight) return;
				if (c.matches(":hover")) return;
				if (current < 0) return;
				const subRef = currentSub >= 0 ? sections[current]?.subs[currentSub] : undefined;
				const active =
					currentLeaf >= 0
						? subRef?.leafLinks[currentLeaf]
						: (subRef?.link ?? sections[current]?.link);
				if (!active) return;
				const cRect = c.getBoundingClientRect();
				const rel = (el: HTMLElement) =>
					el.getBoundingClientRect().top - cRect.top + c.scrollTop;
				const ch = c.clientHeight;
				let st = c.scrollTop;
				// innermost expanded group wins for the fit-into-view pass
				const group =
					subRef && expanded2At(current, currentSub)
						? subRef.li
						: expandedAt(current)
							? sections[current]?.li
							: undefined;
				if (group && group.offsetHeight <= ch) {
					const gTop = rel(group);
					const gBottom = gTop + group.offsetHeight;
					if (gBottom > st + ch) st = gBottom - ch;
					if (gTop < st) st = gTop;
				}
				const aTop = rel(active);
				const aBottom = aTop + active.offsetHeight;
				const pad = 6;
				if (aTop < st + pad) st = aTop - pad;
				else if (aBottom > st + ch - pad) st = aBottom - ch + pad;
				if (Math.abs(st - c.scrollTop) > 1) {
					c.scrollTo({ top: st, behavior: reduceMotion ? "auto" : "smooth" });
				}
			}, 300);
		};

		const toggle = (i: number) => {
			if (expandedAt(i)) {
				if (m1Open.has(i)) m1Open.delete(i);
				else m1Closed.add(i);
			} else {
				m1Open.add(i);
				m1Closed.delete(i);
			}
			apply();
			scheduleReveal();
		};
		const toggle2 = (i: number, j: number) => {
			const key = `${i}:${j}`;
			if (expanded2At(i, j)) {
				if (m2Open.has(key)) m2Open.delete(key);
				else m2Closed.add(key);
			} else {
				m2Open.add(key);
				m2Closed.delete(key);
			}
			apply();
			scheduleReveal();
		};
		sections.forEach((s, i) => {
			s.caret?.addEventListener("click", () => toggle(i));
			s.subs.forEach((sub, j) => {
				sub.caret?.addEventListener("click", () => toggle2(i, j));
			});
		});

		// —— scrollspy + Top link visibility ——
		const tops = [...document.querySelectorAll<HTMLElement>("[data-toc-top]")];
		for (const t of tops) {
			t.addEventListener("click", () => {
				window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
			});
		}

		const THRESH = 130;
		const postH1 = document.querySelector<HTMLElement>(".post-header h1");
		let ticking = false;
		const update = () => {
			ticking = false;
			/* before the first h2 is reached (reading the lede), nothing
			 * is current and nothing highlights */
			let cur = -1;
			sections.forEach((s, i) => {
				if (s.h2 && s.h2.getBoundingClientRect().top < THRESH) cur = i;
			});
			let sub = -1;
			let leaf = -1;
			/* a final section shorter than the viewport can never cross the
			 * threshold; at the page bottom, snap to the very end */
			const atBottom =
				window.innerHeight + window.scrollY >=
				document.documentElement.scrollHeight - 2;
			if (atBottom && sections.length) {
				cur = sections.length - 1;
				sub = sections[cur].subs.length - 1;
				leaf = sub >= 0 ? sections[cur].subs[sub].h4s.length - 1 : -1;
			} else if (cur >= 0) {
				sections[cur].subs.forEach((se, j) => {
					if (se.h3 && se.h3.getBoundingClientRect().top < THRESH) sub = j;
				});
				if (sub >= 0) {
					sections[cur].subs[sub].h4s.forEach((h, k) => {
						if (h.getBoundingClientRect().top < THRESH) leaf = k;
					});
				}
			}
			const changed =
				cur !== current || sub !== currentSub || leaf !== currentLeaf;
			if (cur !== current) {
				m1Open.delete(current);
				m1Closed.delete(current);
				clearM2For(current);
				current = cur;
			} else if (sub !== currentSub && currentSub >= 0) {
				clearM2For(current, currentSub);
			}
			currentSub = sub;
			currentLeaf = leaf;
			/* class churn only when the position actually moved */
			if (changed) {
				apply();
				scheduleReveal();
			}
			// appear in step with the post title merging into the header
			const showTop = postH1
				? postH1.getBoundingClientRect().bottom < 60
				: window.scrollY > window.innerHeight;
			for (const t of tops) {
				t.classList.toggle("visible", showTop);
			}
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};
		/* the rail only exists at >=1020px; below that, skip the per-frame
		 * rect measurements entirely (weakest CPUs are the narrow ones) */
		const wide = window.matchMedia("(min-width: 1020px)");
		const arm = () => {
			if (wide.matches) {
				update();
				window.addEventListener("scroll", onScroll, { passive: true });
			} else {
				window.removeEventListener("scroll", onScroll);
			}
		};
		arm();
		wide.addEventListener("change", arm);
	}
</script>

<style is:global>
	[data-toc-root] :is(h2, h3, h4)[id] {
		scroll-margin-top: var(--anchor-offset);
	}
</style>

<style>
	.toc-title {
		display: block;
		font-size: 0.52rem;
		letter-spacing: 0.14em;
		margin-bottom: 0.5rem;
	}

	.toc :global(ul) {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.toc :global(li) {
		margin: 0;
	}

	.toc :global(a) {
		display: block;
		padding: 0.2rem 0.5rem 0.2rem 0.6rem;
		color: var(--date-color);
		text-decoration: none;
		border-radius: 0 4px 4px 0;
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	.toc :global(a:hover) {
		color: var(--heading-color);
		background: var(--code-background);
	}

	/* metric-stable active state: color and background only, never a
	 * weight change (bolding reflows and can rewrap long entries) */
	.toc :global(a.active) {
		color: var(--heading-color);
		background: var(--code-background);
	}

	/* rows sit flush, so a focus ring (2px + 2px offset) reaches into the
	 * neighbours' boxes and an adjacent active row's background would
	 * paint over it; lift the focused row so its ring stays whole.
	 * Links are square on the left to sit flush against the spine, and
	 * the outline inherits that radius, so round all four corners while
	 * focused for a closed ring. */
	.toc :global(a:focus-visible) {
		position: relative;
		z-index: 1;
		border-radius: 4px;
	}

	/* —— sticky left rail (lives in the post-shell grid column) ——
	 * The rail hugs its list (max-height bounds the internal scroll; the
	 * reserve leaves room for the sticky Top button plus its clearance
	 * below), so nothing full-height exists to collide with the footer
	 * at the end of the page. */
	.toc-rail {
		position: sticky;
		top: var(--rail-top);
		max-height: calc(100vh - var(--rail-top) - 3.5rem);
		display: flex;
		flex-direction: column;
		font-size: 0.68rem;
		line-height: 1.5;
	}

	/* solid panel hugging the list content (not the full rail height),
	 * so backdrop art bleeds below a short TOC; pure paint via pseudo
	 * layer on a non-scrolling wrapper (a scroll container would clip
	 * the halo) */
	.toc-rail .toc-panel {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 0;
		margin-bottom: 1rem;
	}

	.toc-rail .toc-panel::before {
		content: "";
		position: absolute;
		inset: -0.7rem;
		background: var(--bg);
		border-radius: 10px;
		z-index: -1;
	}

	.toc-rail .toc-scroll {
		overflow-y: auto;
		min-height: 0;
		/* focus rings draw outside the link box (2px ring + 2px offset)
		 * and this scroll container would clip them at every edge; the
		 * padding gives them room and the negative margin cancels it so
		 * the rail's alignment is unchanged */
		padding: 4px;
		margin: -4px;
		scrollbar-width: thin;
		scrollbar-color: var(--border-color) transparent;
	}

	.toc-rail :global(.toc-row) {
		display: flex;
		align-items: center;
		border-left: 2px solid var(--border-color);
	}

	.toc-rail :global(.toc-row > a) {
		flex: 1;
		min-width: 0;
	}

	.toc-rail :global(.toc-row:has(> a.active)) {
		border-left-color: var(--code-color);
	}

	.toc-rail :global(.toc-caret) {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.25rem;
		height: 1.25rem;
		margin-right: 0.1rem;
		border: 0;
		border-radius: 4px;
		background: transparent;
		color: var(--date-color);
		cursor: pointer;
	}

	.toc-rail :global(.toc-caret:hover) {
		color: var(--heading-color);
		background: var(--code-background);
	}

	.toc-rail :global(.toc-caret svg) {
		transition: transform 0.2s ease;
	}

	.toc-rail :global(.toc-caret.open svg) {
		transform: rotate(90deg);
	}

	.toc-rail :global(.toc-subwrap) {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.25s ease;
	}

	.toc-rail :global(.toc-subwrap.open) {
		grid-template-rows: 1fr;
	}

	.toc-rail :global(.toc-sub) {
		overflow: hidden;
		min-height: 0;
		border-left: 2px solid var(--border-color);
	}

	.toc-rail :global(.toc-sub a) {
		padding-left: 1.4rem;
		font-size: 0.94em;
	}

	/* nested rows sit inside the sub-list's spine; no second border */
	.toc-rail :global(.toc-sub .toc-row),
	.toc-rail :global(.toc-sub .toc-sub) {
		border-left: none;
	}

	.toc-rail :global(.toc-sub2 a) {
		padding-left: 2.2rem;
		font-size: 0.9em;
	}

	.toc-top {
		/* rides 1.25rem above the viewport bottom for the whole read.
		 * Its natural position (end of the .post-rail column) is pushed
		 * below the sticky line by the negative margin, so it never
		 * un-sticks: at full scroll it stays put and overlays the
		 * footer's unused left side (the shell's z-index paints it on
		 * top). The margin absorbs the footer's ~2.05rem height. */
		position: sticky;
		bottom: 1.25rem;
		flex: none;
		align-self: flex-start;
		display: flex;
		/* svg baseline = its bottom edge, so the cropped arrow sits
		 * exactly on the text baseline */
		align-items: baseline;
		gap: 0.4rem;
		margin-top: auto;
		margin-bottom: -2rem;
		padding: 0.34rem 0.55rem 0.26rem;
		line-height: 1;
		border: 1px solid var(--border-color);
		border-radius: 6px;
		/* solid: it overlays the footer at full scroll, and the footer's
		 * hairline would shine through a transparent body */
		background: var(--bg);
		font-size: 0.5rem;
		letter-spacing: 0.1em;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		/* out of the tab order while hidden */
		visibility: hidden;
		transition:
			opacity 0.2s ease,
			color 0.15s ease,
			border-color 0.15s ease,
			visibility 0s linear 0.2s;
	}

	.toc-top-arrow {
		font-size: 0.55rem;
		line-height: 1;
	}

	.toc-top.visible {
		opacity: 1;
		pointer-events: auto;
		visibility: visible;
		transition:
			opacity 0.2s ease,
			color 0.15s ease,
			border-color 0.15s ease,
			visibility 0s;
	}

