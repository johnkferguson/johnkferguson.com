---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_NAME } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { artSvg } from "../lib/art/generate";
import { createExcerpt } from "../lib/excerpt";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/* dev-only mock entries so list scrolling can be judged with a fuller
 * page; never present in production builds */
interface DisplayPost {
	id: string;
	data: {
		title: string;
		date: Date;
		description?: string;
		art?: { family?: "strata" | "field" | "walk" | "depth"; seed?: string };
	};
	body?: string;
}
const mocks: DisplayPost[] = [
	{
		id: "mock-mechanisms-everywhere",
		data: {
			title: "Mechanisms Everywhere: Reading Incentives in the Wild",
			date: new Date("2026-05-14"),
			description:
				"Once you learn to see incentive structures, every queue, auction, and API rate limit becomes a design document.",
			art: { family: "field", seed: "mock-1" },
		},
	},
	{
		id: "mock-quiet-markets",
		data: {
			title: "Quiet Markets",
			date: new Date("2026-04-02"),
			description:
				"What thin order books can teach about patience, and why the absence of trading is itself information.",
			art: { family: "strata", seed: "mock-2" },
		},
	},
	{
		id: "mock-building-in-public",
		data: {
			title: "Building in Public, Thinking in Private",
			date: new Date("2026-03-11"),
			description:
				"A working rhythm for sharing progress without outsourcing judgment to an audience.",
			art: { family: "walk", seed: "mock-3" },
		},
	},
];
const displayPosts: DisplayPost[] = import.meta.env.DEV
	? [...sortedPosts, ...mocks]
	: sortedPosts;

function formatDate(date: Date): string {
	return date.toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric",
		timeZone: "UTC",
	});
}

/* thumbnail = the same slug-seeded piece the post's backdrop uses, so
 * the list previews the artwork you land inside */
function thumbSvg(post: DisplayPost): string {
	return artSvg({
		seedKey: post.data.art?.seed ?? post.id,
		family: post.data.art?.family,
		width: 800,
		height: 560,
	});
}

/* identity backdrop: fresh piece per visit (client script reseeds);
 * this build-seeded render is the no-JS fallback */
const identityArt = artSvg({
	seedKey: "home",
	family: "field",
	width: 800,
	height: 900,
});
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION}>
  <div class="post-shell home-shell">
    <aside class="post-rail home-rail">
      <div class="identity">
        <div class="identity-art" data-identity-art set:html={identityArt} />
        <div class="identity-text">
          <p class="blurb">
            Writing on markets, mechanism design, and building software.
            Currently building a blockchain protocol company.
          </p>
          <a href="/about" class="about-link">about &rarr;</a>
        </div>
      </div>
    </aside>
    <div class="post-main">
      <ul class="post-list">
        {
          displayPosts.map((post) => (
            <li>
              <a href={`/${post.id}`} class="post-card">
                <span class="card-title">{post.data.title}</span>
                <span class="row">
                  <span class="thumb" aria-hidden="true" set:html={thumbSvg(post)} />
                  <span class="meta">
                    <span class="date">
                      {formatDate(post.data.date)}
                      <span class="rt">
                        <svg
                          width="10"
                          height="10"
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          aria-hidden="true"
                        >
                          <circle cx="8" cy="8" r="6.2" />
                          <path d="M8 4.8V8l2.2 1.6" stroke-linecap="round" />
                        </svg>
                        12 min read
                      </span>
                    </span>
                    <span class="desc">
                      {post.data.description || createExcerpt(post.body ?? "")}
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
	import { artSvg } from "../lib/art/generate";

	// the identity backdrop is the one dynamic piece on the site: a
	// fresh field every visit
	const holder = document.querySelector<HTMLElement>("[data-identity-art]");
	if (holder) {
		holder.innerHTML = artSvg({
			seedKey: Math.random().toString(36).slice(2),
			family: "field",
			width: 800,
			height: 900,
		});
	}
</script>

<style>
  /* slim bottom padding so the sticky identity's column reaches far
   * enough down that the footer arrives without pushing it */
  .home-shell {
    padding-bottom: 0.5rem;
  }

  /* identity block shows at every width; stacks above the list when
   * the grid collapses */
  .home-rail {
    display: block;
  }

  /* text flush with the column edge (aligned with the header name);
   * pinned while the list scrolls; sits toward the vertical center */
  .identity {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 1020px) {
    .identity {
      position: sticky;
      /* pin threshold equals the natural resting offset (header 2.1rem
       * + shell padding 1.5rem) so it never travels before pinning; the
       * box ends above footer height so the footer slides in beneath
       * without ever pushing the identity up */
      top: 3.6rem;
      height: calc(100vh - 6.4rem);
    }
  }

  @media (max-width: 1019px) {
    .identity {
      min-height: 11rem;
      margin-bottom: 2rem;
    }
  }

  /* unboxed art: fills the whole left area up to the header, dissolving
   * at every edge (no panel, no defined boundary) */
  .identity-art {
    position: absolute;
    top: -1.5rem;
    bottom: -1rem;
    left: -1rem;
    right: -1.5rem;
    opacity: 0.5;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(
      80% 72% at 45% 48%,
      #000 30%,
      transparent 95%
    );
    mask-image: radial-gradient(
      80% 72% at 45% 48%,
      #000 30%,
      transparent 95%
    );
  }

  .identity-art :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .identity-text {
    position: relative;
  }

  .blurb {
    font-size: 0.82rem;
    line-height: 1.55;
    margin: 0 0 0.6rem;
    text-shadow:
      0 0 8px var(--bg),
      0 0 16px var(--bg),
      0 0 28px var(--bg);
  }

  .about-link {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--date-color);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .about-link:hover {
    color: var(--heading-color);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--prose-measure);
  }

  .post-list li {
    /* matches the separator's margin below so the line sits centered */
    margin-bottom: 0.7rem;
  }

  /* subtle centered separator between posts */
  .post-list li + li::before {
    content: "";
    display: block;
    width: 38%;
    height: 1px;
    margin: 0 auto 0.7rem;
    background: color-mix(in srgb, var(--border-color) 65%, transparent);
  }

  /* whole item is one link; hover lifts it on a soft surface */
  .post-card {
    display: block;
    padding: 0.8rem 0.9rem;
    margin: 0 -0.9rem;
    border-radius: 10px;
    border-bottom: none;
    transition: background-color 0.18s ease;
  }

  .post-card:hover {
    background: color-mix(in srgb, var(--code-background) 55%, transparent);
  }

  .card-title {
    display: block;
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--heading-color);
  }

  .row {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin-top: 0.3rem;
  }

  /* diffuse thumbnail: no border or box; the art dissolves into the
   * page via a radial mask */
  .thumb {
    flex: none;
    width: 7.6rem;
    height: 5.2rem;
    -webkit-mask-image: radial-gradient(
      ellipse 92% 88% at 50% 50%,
      #000 45%,
      transparent 98%
    );
    mask-image: radial-gradient(
      ellipse 92% 88% at 50% 50%,
      #000 45%,
      transparent 98%
    );
  }

  .thumb :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .meta {
    display: block;
    min-width: 0;
  }

  .date {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    color: var(--date-color);
    margin: 0.15rem 0 0.4rem;
  }

  .rt {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .desc {
    display: block;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-color);
  }
</style>
