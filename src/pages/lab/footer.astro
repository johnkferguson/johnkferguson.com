---
// Footer variant gallery: three thin footer candidates in the real
// palette, stacked with labels. Unpublished playground (/lab/).
import BaseLayout from "../../layouts/BaseLayout.astro";

const year = new Date().getFullYear();
---

<BaseLayout title="Footer Variants" description="Thin footer candidates" noindex>
  <div class="stage">
    <p class="note">
      Three footer candidates, each ~40px tall (current footer is ~90px).
      Toggle the theme to check both modes. Icons: GitHub, X, RSS.
    </p>

    <div class="variant">
      <span class="tag">A — mono text links</span>
      <div class="fake-content"></div>
      <footer class="f fa">
        <span class="copyright">© {year} John K. Ferguson</span>
        <nav class="links">
          <a href="#">github</a>
          <a href="#">x</a>
          <a href="#">rss</a>
        </nav>
      </footer>
    </div>

    <div class="variant">
      <span class="tag">B — small icons</span>
      <div class="fake-content"></div>
      <footer class="f fb">
        <span class="copyright">© {year} John K. Ferguson</span>
        <nav class="links icons">
          <a href="#" aria-label="GitHub">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          <a href="#" aria-label="X">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M9.5 6.8 15.3 0h-1.4L8.9 5.9 4.9 0H.3l6.1 8.9L.3 16h1.4l5.3-6.2 4.3 6.2h4.6L9.5 6.8Zm-1.9 2.2-.6-.9L2.2 1h2.1l4 5.7.6.9 5.1 7.4h-2.1L7.6 9Z"/></svg>
          </a>
          <a href="#" aria-label="RSS">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2.5 13.5a1.5 1.5 0 1 1-.001-2.999A1.5 1.5 0 0 1 2.5 13.5ZM1 5.5v2a7.5 7.5 0 0 1 7.5 7.5h2A9.5 9.5 0 0 0 1 5.5Zm0-4.5v2c6.35 0 11.5 5.15 11.5 11.5h2C14.5 7.04 8.46 1 1 1Z"/></svg>
          </a>
        </nav>
      </footer>
    </div>

    <div class="variant">
      <span class="tag">C — one centered line</span>
      <div class="fake-content"></div>
      <footer class="f fc">
        <span>© {year}</span>
        <span class="sep">·</span>
        <a href="#">GitHub</a>
        <span class="sep">·</span>
        <a href="#">X</a>
        <span class="sep">·</span>
        <a href="#">RSS</a>
      </footer>
    </div>

    <div class="variant">
      <span class="tag">D — centered, all lowercase</span>
      <div class="fake-content"></div>
      <footer class="f fc">
        <span>© {year}</span>
        <span class="sep">·</span>
        <a href="#">github</a>
        <span class="sep">·</span>
        <a href="#">x</a>
        <span class="sep">·</span>
        <a href="#">rss</a>
      </footer>
    </div>

    <div class="variant">
      <span class="tag">C2 — serif (Newsreader)</span>
      <div class="fake-content"></div>
      <footer class="f fc serif">
        <span>© {year}</span>
        <span class="sep">·</span>
        <a href="#">GitHub</a>
        <span class="sep">·</span>
        <a href="#">X</a>
        <span class="sep">·</span>
        <a href="#">RSS</a>
      </footer>
    </div>

    <div class="variant">
      <span class="tag">C3 — serif italic</span>
      <div class="fake-content"></div>
      <footer class="f fc serif italic">
        <span>© {year}</span>
        <span class="sep">·</span>
        <a href="#">GitHub</a>
        <span class="sep">·</span>
        <a href="#">X</a>
        <span class="sep">·</span>
        <a href="#">RSS</a>
      </footer>
    </div>

    <div class="variant">
      <span class="tag">C4 — serif small caps</span>
      <div class="fake-content"></div>
      <footer class="f fc serif smallcaps">
        <span>© {year}</span>
        <span class="sep">·</span>
        <a href="#">github</a>
        <span class="sep">·</span>
        <a href="#">x</a>
        <span class="sep">·</span>
        <a href="#">rss</a>
      </footer>
    </div>

    <div class="variant">
      <span class="tag">E — centered with name</span>
      <div class="fake-content"></div>
      <footer class="f fc">
        <span>© {year} John K. Ferguson</span>
        <span class="sep">·</span>
        <a href="#">GitHub</a>
        <span class="sep">·</span>
        <a href="#">X</a>
        <span class="sep">·</span>
        <a href="#">RSS</a>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  .stage {
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: 2rem var(--shell-pad) 4rem;
  }

  .note {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--date-color);
    margin-bottom: 2rem;
  }

  .variant {
    margin-bottom: 3rem;
  }

  .tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--date-color);
    margin-bottom: 0.6rem;
  }

  .fake-content {
    height: 3rem;
    border-inline: 1px dashed var(--border-color);
    opacity: 0.5;
  }

  /* —— shared footer bones: thin single row —— */
  .f {
    display: flex;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding: 0.55rem 0;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    color: var(--date-color);
  }

  .f a {
    color: var(--date-color);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .f a:hover {
    color: var(--heading-color);
  }

  .copyright {
    flex: 1;
  }

  /* A: text links right */
  .fa .links {
    display: flex;
    gap: 1.1rem;
    text-transform: lowercase;
  }

  /* B: icons right */
  .fb .links.icons {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .fb .links.icons a {
    display: flex;
  }

  /* C: centered line */
  .fc {
    justify-content: center;
    gap: 0.55rem;
  }

  .fc .sep {
    opacity: 0.5;
  }

  /* C font variants: serif needs a larger px size to match mono's
   * apparent size */
  .f.serif {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .f.serif.italic {
    font-style: italic;
  }

  .f.serif.smallcaps {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
  }
</style>
