---
// Page shell only: layout, width, TOC rail, article styling. The article
// itself (prose, headings, labs) lives in src/content/labs/snapshot-fees.mdx.
import "katex/dist/katex.min.css";
import BackToTop from "../../components/BackToTop.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Article from "../../content/labs/snapshot-fees.mdx";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Lab · Snapshot Fees"
	description="Interactive playground for the snapshot-fees mechanism and the article skeleton around it."
	noindex={true}
>
	<TableOfContents />
	<BackToTop />
	<main class="mx-auto w-full max-w-[720px] px-3 py-8">
		<article data-toc-root>
			<Article />
		</article>
	</main>
</BaseLayout>

<style>
	article :global(.stub) {
		color: var(--date-color);
	}

	article :global(.stub li) {
		margin-bottom: 0.15rem;
	}

	article :global(.labwrap) {
		margin: 1.25rem 0 2rem;
	}

	article :global(h2) {
		margin-top: 2.4rem;
	}

	article :global(.katex-display) {
		margin: 1.5rem 0;
		padding: 0.9rem 1rem;
		background: var(--code-background);
		border: 1px solid var(--border-color);
		border-radius: 6px;
		overflow-x: auto;
	}

	/* KaTeX default is 1.21em; nudge up slightly at body size */
	article :global(.katex-display .katex) {
		font-size: 1.25em;
	}
</style>
