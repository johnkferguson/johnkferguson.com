---
import SnapshotFeesLab from "../../components/labs/SnapshotFeesLab";
import SnapshotFeesMultiLab from "../../components/labs/SnapshotFeesMultiLab";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Lab · Snapshot Fees"
	description="Interactive playground for the snapshot-fees mechanism — a single-maker batch-auction fee laboratory."
	noindex={true}
>
	<main class="mx-auto w-full max-w-[720px] px-3 py-8">
		<SnapshotFeesLab client:load />
		<div class="mt-16">
			<SnapshotFeesMultiLab client:load />
		</div>
	</main>
</BaseLayout>
