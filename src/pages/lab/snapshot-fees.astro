---
// Page shell only: layout, width, TOC rail, article styling. The article
// itself (prose, headings, labs) lives in src/content/labs/snapshot-fees.mdx.
import TableOfContents from "../../components/TableOfContents.astro";
import Article from "../../content/labs/snapshot-fees.mdx";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Lab · Snapshot Fees"
	description="Interactive playground for the snapshot-fees mechanism and the article skeleton around it."
	noindex={true}
>
	<TableOfContents />
	<main class="mx-auto w-full max-w-[720px] px-3 py-8">
		<article data-toc-root>
			<Article />
		</article>
	</main>
</BaseLayout>

<style>
	article :global(.stub) {
		color: var(--date-color);
	}

	article :global(.stub li) {
		margin-bottom: 0.15rem;
	}

	article :global(.labwrap) {
		margin: 1.25rem 0 2rem;
	}

	article :global(h2) {
		margin-top: 2.4rem;
	}
</style>
