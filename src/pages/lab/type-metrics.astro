---
// Type-metrics comparison harness: the real snapshot-fees page in an
// iframe with one toggle per proposed change, applied live as CSS
// overrides. Unpublished playground (/lab/), for design review only.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Type Metrics Lab</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: "Fira Code", monospace;
        background: #16130f;
        color: #c4bdb6;
      }
      .panel {
        flex: none;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.9rem;
        padding: 0.5rem 0.9rem;
        font-size: 12px;
        border-bottom: 1px solid #3a3533;
      }
      .panel label {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        cursor: pointer;
        white-space: nowrap;
      }
      .panel .group {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.15rem 0.55rem;
        border: 1px solid #3a3533;
        border-radius: 6px;
      }
      .panel .group-label {
        color: #8a8480;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      iframe {
        flex: 1;
        border: 0;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <div class="panel" data-panel>
      <div class="group">
        <span class="group-label">page</span>
        <label><input type="radio" name="page" value="/snapshot-fees" checked /> snapshot-fees</label>
        <label><input type="radio" name="page" value="/refactoring-with-love" /> refactoring</label>
        <label><input type="radio" name="page" value="/lab/toc-test" /> toc-test</label>
      </div>
      <div class="group">
        <span class="group-label">light mode warmth</span>
        <label><input type="radio" name="warmth" value="warm0" checked /> current</label>
        <label><input type="radio" name="warmth" value="warmsubtle" /> subtle</label>
        <label><input type="radio" name="warmth" value="warmlight" /> warm</label>
      </div>
      <label><input type="checkbox" value="mutedbump" /> muted gray contrast bump</label>
      <div class="group">
        <span class="group-label">blockquotes</span>
        <label><input type="radio" name="bq" value="bq0" checked /> current</label>
        <label><input type="radio" name="bq" value="bqitalic" /> full size+ink, italic</label>
        <label><input type="radio" name="bq" value="bqroman" /> full size+ink, roman</label>
      </div>
      <label><input type="checkbox" value="accent" /> accent: TOC spine + copied</label>
      <div class="group">
        <span class="group-label">code red (light)</span>
        <label><input type="radio" name="red" value="red0" checked /> current</label>
        <label><input type="radio" name="red" value="redhalf" /> halfway</label>
        <label><input type="radio" name="red" value="reddeep" /> deep</label>
      </div>
      <label><input type="checkbox" value="chipweight" /> chip/code weight bump</label>
    </div>
    <iframe src="/snapshot-fees" title="post preview"></iframe>

    <script>
      const RULES: Record<string, string> = {
        warmsubtle: [
          ":root:not(.dark){",
          "--bg:#fdfcfb;--bg-footer:#faf9f7;--text-color:#3b3936;",
          "--heading-color:#201e1c;--link-color:#262422;--link-hover:#000;",
          "--border-color:#e8e5e1;--code-background:#f6f4f0;",
          "--date-color:#837f7a;--article-link-border:#ddd9d4;",
          "--blockquote-border:#e8e5e1;}",
        ].join(""),
        warmlight: [
          ":root:not(.dark){",
          "--bg:#faf9f7;--bg-footer:#f6f4f0;--text-color:#3b3733;",
          "--heading-color:#211d1a;--link-color:#2a2621;--link-hover:#000;",
          "--border-color:#e7e2db;--code-background:#f3efe8;",
          "--date-color:#867e74;--article-link-border:#ddd7cf;",
          "--blockquote-border:#e7e2db;}",
        ].join(""),
        mutedbump:
          ":root:not(.dark){--date-color:#6e6961}.dark{--date-color:#98928b}",
        bqitalic:
          "article blockquote{opacity:1 !important;color:var(--text-color) !important;font-size:1rem !important}",
        bqroman:
          "article blockquote{opacity:1 !important;color:var(--text-color) !important;font-size:1rem !important;font-style:normal !important}",
        accent: [
          ".toc-rail .toc-row:has(> a.active){border-left-color:var(--code-color) !important}",
          ".anchor-link.copied{color:var(--code-color) !important}",
        ].join("\n"),
        redhalf:
          ":root:not(.dark){--code-color:#b1525b}.dark{--code-color:#cb7a62}",
        reddeep:
          ":root:not(.dark){--code-color:#a3454f}.dark{--code-color:#c26a51}",
        chipweight:
          "article code{font-weight:500 !important} article .katex{font-weight:600 !important}",
      };
      const STORE = "type-metrics-toggles";
      const frame = document.querySelector("iframe");
      const panel = document.querySelector("[data-panel]");
      if (frame && panel) {
        const inputs = [...panel.querySelectorAll<HTMLInputElement>("input")];
        const apply = () => {
          const doc = frame.contentDocument;
          if (!doc?.head) return;
          let el = doc.getElementById("metrics-overrides");
          if (!el) {
            el = doc.createElement("style");
            el.id = "metrics-overrides";
            doc.head.append(el);
          }
          const active = inputs
            .filter((i) => i.checked && RULES[i.value])
            .map((i) => RULES[i.value]);
          el.textContent = active.join("\n");
          localStorage.setItem(
            STORE,
            JSON.stringify(
              inputs.filter((i) => i.checked).map((i) => i.value),
            ),
          );
        };
        const saved: string[] = JSON.parse(
          localStorage.getItem(STORE) ?? "[]",
        );
        if (saved.length) {
          for (const i of inputs) {
            if (i.type === "checkbox") i.checked = saved.includes(i.value);
            else i.checked = saved.includes(i.value);
          }
          if (!saved.some((v) => v.startsWith("weight"))) {
            const def = inputs.find((i) => i.value === "weight700");
            if (def) def.checked = true;
          }
        }
        panel.addEventListener("change", (e) => {
          const t = e.target as HTMLInputElement;
          if (t.name === "page") {
            frame.src = t.value;
            return; // overrides reapply on the load event
          }
          apply();
        });
        frame.addEventListener("load", apply);
      }
    </script>
  </body>
</html>
