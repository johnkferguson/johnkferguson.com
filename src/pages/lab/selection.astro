---
/* Selection-color harness (dev only, never deployed).
 * Preset blocks to compare at a glance, plus a live picker: choose a hue
 * and alpha, drag-select the sample, and read off the value to keep.
 * Per-theme values are independent — set the picker in each mode. */
import BaseLayout from "../../layouts/BaseLayout.astro";

const candidates = [
	{
		key: "terracotta",
		label: "current terracotta",
		dark: "rgba(208, 135, 112, 0.30)",
		light: "rgba(191, 97, 106, 0.30)",
	},
	{
		key: "a",
		label: "A — nord yellow, soft",
		dark: "rgba(235, 203, 139, 0.26)",
		light: "rgba(228, 193, 88, 0.28)",
	},
	{
		key: "b",
		label: "B — nord yellow, stronger",
		dark: "rgba(235, 203, 139, 0.42)",
		light: "rgba(228, 193, 88, 0.40)",
	},
	{
		key: "c",
		label: "C — saturated yellow",
		dark: "rgba(243, 216, 122, 0.34)",
		light: "rgba(236, 200, 70, 0.34)",
	},
	{
		key: "d",
		label: "D — pale butter",
		dark: "rgba(252, 233, 168, 0.30)",
		light: "rgba(240, 214, 130, 0.34)",
	},
];

const sample =
	"The snapshot prices liquidity from within the batch auction itself, so a maker quoting near the Measured Price pays less than one reaching for the edges. Selection should feel like a highlighter laid over the page, not a block of paint.";
---

<BaseLayout
  title="Lab: selection color"
  description="Selection color harness"
  noindex
>
  <div class="wrap">
    <h1>Selection color</h1>
    <p class="hint">
      Drag-select each block. Flip the header's theme toggle and repeat — the
      two modes need different values. The picker at the bottom is live.
    </p>

    {
      candidates.map((c) => (
        <section class={`cand sel-${c.key}`}>
          <div class="lab micro-label">{c.label}</div>
          <p>{sample}</p>
        </section>
      ))
    }

    <hr />

    <section class="cand sel-pick">
      <div class="lab micro-label">picker — live</div>
      <p>{sample}</p>
    </section>

    <div class="controls">
      <label>
        <span class="micro-label">color</span>
        <input type="color" id="pick-color" value="#ebcb8b" />
      </label>
      <label>
        <span class="micro-label">alpha <output id="alpha-out">0.30</output></span>
        <input type="range" id="pick-alpha" min="0" max="1" step="0.01" value="0.30" />
      </label>
      <div class="readout">
        <code id="value-out">rgba(235, 203, 139, 0.30)</code>
        <button type="button" id="copy-btn" class="micro-label">copy</button>
      </div>
      <p class="hint composite">
        effective over page background: <span id="composite-out"></span>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const colorEl = document.getElementById("pick-color") as HTMLInputElement;
  const alphaEl = document.getElementById("pick-alpha") as HTMLInputElement;
  const alphaOut = document.getElementById("alpha-out") as HTMLElement;
  const valueOut = document.getElementById("value-out") as HTMLElement;
  const compositeOut = document.getElementById("composite-out") as HTMLElement;
  const copyBtn = document.getElementById("copy-btn") as HTMLElement;

  const styleTag = document.createElement("style");
  document.head.append(styleTag);

  const hexToRgb = (hex: string): [number, number, number] => [
    Number.parseInt(hex.slice(1, 3), 16),
    Number.parseInt(hex.slice(3, 5), 16),
    Number.parseInt(hex.slice(5, 7), 16),
  ];

  const apply = () => {
    const [r, g, b] = hexToRgb(colorEl.value);
    const a = Number(alphaEl.value);
    const value = `rgba(${r}, ${g}, ${b}, ${a.toFixed(2)})`;
    alphaOut.textContent = a.toFixed(2);
    valueOut.textContent = value;
    styleTag.textContent = `.sel-pick ::selection{background:${value}}`;

    /* what the wash actually becomes once composited on the page */
    const bg = getComputedStyle(document.body).backgroundColor;
    const m = bg.match(/\d+/g)?.map(Number) ?? [255, 255, 255];
    const eff = [r, g, b].map((c, i) => Math.round(m[i] * (1 - a) + c * a));
    compositeOut.textContent = `rgb(${eff.join(", ")})`;
    compositeOut.style.cssText = `background:rgb(${eff.join(",")});padding:0 .5rem;border-radius:3px`;
  };

  colorEl.addEventListener("input", apply);
  alphaEl.addEventListener("input", apply);
  copyBtn.addEventListener("click", async () => {
    await navigator.clipboard.writeText(valueOut.textContent ?? "");
    copyBtn.textContent = "copied";
    setTimeout(() => {
      copyBtn.textContent = "copy";
    }, 1200);
  });
  /* recomposite when the theme flips */
  new MutationObserver(apply).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
  apply();
</script>

<style is:global>
  /* preset blocks: per-theme selection colors */
  .sel-terracotta ::selection { background: rgba(191, 97, 106, 0.3); }
  .sel-a ::selection { background: rgba(228, 193, 88, 0.28); }
  .sel-b ::selection { background: rgba(228, 193, 88, 0.4); }
  .sel-c ::selection { background: rgba(236, 200, 70, 0.34); }
  .sel-d ::selection { background: rgba(240, 214, 130, 0.34); }

  .dark .sel-terracotta ::selection { background: rgba(208, 135, 112, 0.3); }
  .dark .sel-a ::selection { background: rgba(235, 203, 139, 0.26); }
  .dark .sel-b ::selection { background: rgba(235, 203, 139, 0.42); }
  .dark .sel-c ::selection { background: rgba(243, 216, 122, 0.34); }
  .dark .sel-d ::selection { background: rgba(252, 233, 168, 0.3); }
</style>

<style>
  .wrap {
    max-width: var(--prose-measure);
    margin: 0 auto;
    padding: 2rem var(--shell-pad) 5rem;
  }

  .hint {
    font-size: 0.75rem;
    color: var(--date-color);
    margin-bottom: 2rem;
  }

  .cand {
    margin-bottom: 1.5rem;
  }

  .lab {
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.2rem;
  }

  .cand p {
    margin: 0;
  }

  hr {
    border: 0;
    border-top: 1px solid var(--border-color);
    margin: 2.5rem 0;
  }

  .controls {
    margin-top: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .controls label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.6rem;
  }

  .controls input[type="color"] {
    width: 3rem;
    height: 1.8rem;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    cursor: pointer;
  }

  .controls input[type="range"] {
    flex: 1;
    max-width: 16rem;
    accent-color: var(--code-color);
  }

  .readout {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .readout code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: var(--code-background);
    color: var(--code-color);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
  }

  #copy-btn {
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
  }

  #copy-btn:hover {
    color: var(--heading-color);
    border-color: var(--article-link-hover-border);
  }

  .composite {
    margin: 0;
  }
</style>
