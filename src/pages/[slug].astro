---
import { render } from "astro:content";
import PostLayout from "../layouts/PostLayout.astro";
import { createExcerpt } from "../lib/excerpt";
import { getVisiblePosts, IS_DEV } from "../lib/posts";
import { readingTimeMinutes } from "../lib/reading-time";

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const description = post.data.description || createExcerpt(post.body ?? "");
const readingMinutes = readingTimeMinutes(post.body ?? "", post.data.pace);
---

<PostLayout
  title={post.data.title}
  description={description}
  pubDate={post.data.date}
  updated={post.data.updated}
  tags={post.data.tags}
  author="John K. Ferguson"
  slug={post.id}
  art={post.data.art}
  readingMinutes={readingMinutes}
  headings={headings}
  draftBadge={IS_DEV && post.data.draft === true}
>
  <Content />
</PostLayout>
