---
import { getEntry, render } from "astro:content";
import { SITE_NAME } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { artSvg } from "../lib/art/generate";

const page = await getEntry("pages", "about");
if (!page) {
	throw new Error("Missing content/pages/about.md");
}
const { Content } = await render(page);

const title = `${page.data.title} — ${SITE_NAME}`;

/* stable piece (fixed seed, unlike the homepage's per-visit art);
 * the left column is also where a portrait would eventually live */
const aboutArt = artSvg({
	seedKey: "about",
	family: "field",
	width: 800,
	height: 900,
});
---

<BaseLayout title={title} description={page.data.description ?? ""}>
  <div class="post-shell">
    <aside class="post-rail about-rail">
      <div class="about-side">
        <div class="about-art" set:html={aboutArt} />
      </div>
    </aside>
    <div class="post-main">
      <header class="about-header">
        <h1>{page.data.title}</h1>
      </header>
      <article data-toc-root>
        <Content />
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  /* decorative only for now; hidden when the grid collapses */
  .about-rail {
    display: none;
  }

  @media (min-width: 1020px) {
    .about-rail {
      display: block;
    }

    .about-side {
      position: sticky;
      top: 3.6rem;
      height: calc(100vh - 6.4rem);
    }
  }

  .about-art {
    position: absolute;
    top: -1.5rem;
    bottom: -1rem;
    left: -1rem;
    right: -1.5rem;
    opacity: 0.5;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(
      80% 72% at 45% 48%,
      #000 30%,
      transparent 95%
    );
    mask-image: radial-gradient(80% 72% at 45% 48%, #000 30%, transparent 95%);
  }

  .about-art :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .about-header h1 {
    font-size: 2.1rem;
    line-height: 1.1;
    margin: 0 0 1.4rem;
  }
</style>
