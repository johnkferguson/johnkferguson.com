---
import BaseLayout from "../layouts/BaseLayout.astro";
import { artSvg } from "../lib/art/generate";

/* a lost walk: the 404 gets its own seeded piece, same system as posts */
const art = artSvg({ seedKey: "404", family: "walk", width: 800, height: 520 });
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  noindex
>
  <div class="nf">
    <div class="nf-art" aria-hidden="true" set:html={art} />
    <div class="nf-text">
      <p class="nf-code micro-label">404</p>
      <h1>There's nothing here</h1>
      <p class="nf-blurb">
        The page you're looking for doesn't exist or has moved.
      </p>
      <a href="/" class="link-underline">Back to home</a>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    position: relative;
    max-width: var(--prose-measure);
    margin: 0 auto;
    padding: 18vh var(--shell-pad) 4rem;
  }

  /* the art dissolves behind the text, side-art style */
  .nf-art {
    position: absolute;
    inset: 0 -3rem -4rem;
    opacity: 0.5;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(
      85% 75% at 50% 45%,
      #000 25%,
      transparent 92%
    );
    mask-image: radial-gradient(85% 75% at 50% 45%, #000 25%, transparent 92%);
  }

  .nf-art :global(svg) {
    width: 100%;
    height: 100%;
  }

  .nf-text {
    position: relative;
    text-shadow:
      0 0 8px var(--bg),
      0 0 16px var(--bg),
      0 0 28px var(--bg);
  }

  .nf-code {
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    margin: 0 0 0.4rem;
  }

  .nf h1 {
    margin-top: 0;
  }

  .nf-blurb {
    color: var(--text-color);
    margin-bottom: 1.4rem;
  }
</style>
