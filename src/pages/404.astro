---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="py-8">
    <div class="max-w-[30rem] mx-auto px-3">
      <h1 class="text-2xl font-bold leading-tight mb-2">Page Not Found</h1>
      <p>The page you're looking for doesn't exist.</p>
      <p>
        <a href="/" class="link-underline transition-colors">
          Back to home
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
