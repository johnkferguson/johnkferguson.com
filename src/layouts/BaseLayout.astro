---
import "../styles/fonts.css";
import firaCodeWoff2 from "@fontsource/fira-code/files/fira-code-latin-400-normal.woff2?url";
import newsreaderWoff2 from "../assets/fonts/newsreader-latin-opsz-normal.woff2?url";
import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/500.css";
import "@fontsource/fira-code/700.css";
import "../styles/global.css";
import Head from "../components/Head.astro";
import JsonLd from "../components/JsonLd.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { COUNTED_HOST } from "../lib/analytics";
import { themeColors } from "../lib/palette";

/* The theme script below must stay inline and blocking, or the page
 * paints in the wrong theme before it runs. define:vars implies
 * is:inline, so it does — but adding is:inline alongside it, or moving
 * the script, can push it onto the bundled-and-deferred path. Nothing
 * tests for this; the symptom is a flash of the wrong theme. */

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	type?: "website" | "article";
	pubDate?: Date;
	updated?: Date;
	tags?: string[];
	noindex?: boolean;
	/* shown in the pinned header bar once the page's h1 scrolls off */
	headerContextTitle?: string;
	headerContextDate?: string;
}

const {
	title,
	description,
	ogImage,
	type = "website",
	pubDate,
	updated,
	tags,
	noindex,
	headerContextTitle,
	headerContextDate,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="preload" href={newsreaderWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={firaCodeWoff2} as="font" type="font/woff2" crossorigin />
    <Head title={title} description={description} ogImage={ogImage} type={type} pubDate={pubDate} updated={updated} tags={tags} noindex={noindex} />
    <JsonLd type={type} title={title} description={description} ogImage={ogImage} pubDate={pubDate} updated={updated} tags={tags} />
    <slot name="head" />
    <script define:vars={{ themeColors }}>
      (function() {
        // stored choice wins; else the OS preference; dark if neither.
        // localStorage can throw in locked-down contexts; theming must
        // still resolve.
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          try {
            theme = window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light' : 'dark';
          } catch (e) { theme = 'dark'; }
        }
        if (theme === 'dark') document.documentElement.classList.add('dark');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', themeColors[theme]);
      })();
    </script>
    <!-- GoatCounter. count.js is vendored into public/ so the Lighthouse
         third-party budget of 0 holds: it skips localhost on its own, so
         no beacon fires there. The guard keeps deploy previews from
         counting; only the beacon itself goes to goatcounter.com. Lab
         events (components/lab-tracking.ts) read the no_onload flag set
         here, so this is the only copy of the host rule. -->
    <script define:vars={{ countedHost: COUNTED_HOST }}>
      window.goatcounter = {
        no_onload: location.hostname.replace(/^www\./, '') !== countedHost,
      };
    </script>
    <script is:inline data-goatcounter="https://jkf.goatcounter.com/count" async src="/goatcounter/count.js"></script>
  </head>
  <body style="background-color: var(--bg); color: var(--text-color);">
    <SiteHeader postTitle={headerContextTitle} postDate={headerContextDate} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
