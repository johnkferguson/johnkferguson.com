---
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	author?: string;
}

const { title, description, pubDate, author } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-US", {
	month: "long",
	day: "numeric",
	year: "numeric",
});
---

<BaseLayout title={title} description={description} type="article" pubDate={pubDate} author={author}>
  <div class="pt-0 pb-8">
    <div class="max-w-[30rem] mx-auto px-3">
      <header class="mb-[1.2rem]">
        <h1 class="text-2xl font-bold leading-tight mb-2">{title}</h1>
        <p class="text-sm mt-1 text-[var(--date-color)]">{formattedDate}</p>
      </header>
      <article class="max-w-none">
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>
