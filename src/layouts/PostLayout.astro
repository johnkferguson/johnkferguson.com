---
import type { MarkdownHeading } from "astro";
import BackToTop from "../components/BackToTop.astro";
import ReadingTime from "../components/ReadingTime.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { artSvg, DEFAULT_QUIET } from "../lib/art/generate";
/* ?raw keeps math.css out of the CSS module graph: Astro ships
 * component-imported CSS to every page in the graph whether or not the
 * importing markup rendered, and this must ship only with hasMath */
import mathCss from "../styles/math.css?raw";
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	author?: string;
	noindex?: boolean;
	slug?: string;
	readingMinutes?: number;
	/** build-time headings (from render(post)); the TOC renders from these */
	headings?: MarkdownHeading[];
	/** post body contains math (containsMath); gates the KaTeX CSS */
	hasMath?: boolean;
	/** dev-only marker for draft posts */
	draftBadge?: boolean;
	art?: {
		family?: "strata" | "field" | "walk" | "depth";
		seed?: string;
		image?: string;
	};
}

const {
	title,
	description,
	pubDate,
	author,
	noindex,
	slug,
	art,
	readingMinutes,
	headings,
	hasMath,
	draftBadge,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-US", {
	month: "long",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
});

/* Backdrop art: an explicit image wins; otherwise generate a fixed piece
 * seeded by the slug (stable across builds and visits). */
const backdropSvg = art?.image
	? null
	: artSvg({
			seedKey: art?.seed ?? slug ?? title,
			family: art?.family,
			width: 1600,
			height: 640,
			/* thin the art where the overlaid title sits */
			quiet: DEFAULT_QUIET,
			quietStrength: 0.4,
		});
---

<BaseLayout
	title={title}
	description={description}
	type="article"
	pubDate={pubDate}
	author={author}
	ogImage={slug ? `/assets/og/${slug}.png` : undefined}
	headerContextTitle={title}
	headerContextDate={formattedDate}
	noindex={noindex}
>
  {
    /* static link + raw-inlined dressing, NOT imports: served from
     * public/katex (scripts/build-katex.py), loaded only when the post
     * has math (issue 20) */
    hasMath && (
      <Fragment slot="head">
        <link rel="stylesheet" href="/katex/katex.min.css" />
        <style set:html={mathCss} />
      </Fragment>
    )
  }
  <div class="post-page">
    <div class="post-backdrop" aria-hidden="true">
      {
        art?.image ? (
          <img src={art.image} alt="" />
        ) : (
          <div class="backdrop-svg" set:html={backdropSvg} />
        )
      }
    </div>
    <div class="post-shell">
      <aside class="post-rail">
        <TableOfContents headings={headings} />
      </aside>
      <div class="post-main">
        <header class="post-header">
          <h1>{title}</h1>
          <p class="post-date">
            {draftBadge && <span class="draft-badge">DRAFT</span>}
            {formattedDate}
            {readingMinutes && <ReadingTime minutes={readingMinutes} />}
          </p>
        </header>
        <TableOfContents inline headings={headings} />
        <article data-toc-root>
          <slot />
        </article>
      </div>
    </div>
    <BackToTop railCoversWide={(headings ?? []).some((h) => h.depth === 2)} />
  </div>
</BaseLayout>

<script>
	// hover anchor: a copy-link button appended to every id'd heading
	const root = document.querySelector("[data-toc-root]");
	if (root) {
		const linkSvg =
			'<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
		const checkSvg =
			'<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
		const headings = root.querySelectorAll<HTMLElement>(
			":is(h2, h3, h4, h5, h6)[id]",
		);
		// screen-reader announcement for successful copies
		const live = document.createElement("div");
		live.setAttribute("aria-live", "polite");
		live.style.cssText =
			"position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)";
		root.append(live);
		for (const h of headings) {
			const btn = document.createElement("button");
			btn.className = "anchor-link";
			btn.type = "button";
			btn.setAttribute("aria-label", "Copy link to this section");
			btn.innerHTML = linkSvg;
			let timer: number | undefined;
			btn.addEventListener("click", async () => {
				const url = `${location.origin}${location.pathname}#${h.id}`;
				try {
					await navigator.clipboard.writeText(url);
				} catch {
					/* clipboard unavailable: no false confirmation */
					return;
				}
				live.textContent = "Link copied";
				btn.innerHTML = checkSvg;
				btn.classList.add("copied");
				clearTimeout(timer);
				timer = window.setTimeout(() => {
					btn.innerHTML = linkSvg;
					btn.classList.remove("copied");
					live.textContent = "";
				}, 1200);
			});
			h.append(btn);
		}

		// hover copy: a button floated over code and math blocks. Math blocks
		// copy their TeX source (KaTeX keeps it in the MathML annotation;
		// selecting rendered KaTeX by hand yields garbled text), code blocks
		// copy their text. Each block is moved into a positioning wrapper
		// because pre and .katex-display are horizontal scroll containers —
		// a button inside would scroll away with the content.
		const copySvg =
			'<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>';
		const blocks = root.querySelectorAll<HTMLElement>("pre, .katex-display");
		for (const block of blocks) {
			const isMath = block.classList.contains("katex-display");
			const textOf = () =>
				isMath
					? (block.querySelector('annotation[encoding="application/x-tex"]')
							?.textContent ?? "")
					: (block.querySelector("code")?.textContent ??
						block.textContent ??
						"");
			if (!textOf().trim()) continue;
			const wrap = document.createElement("div");
			wrap.className = "block-copy-wrap";
			block.before(wrap);
			wrap.append(block);
			const btn = document.createElement("button");
			btn.className = "block-copy";
			btn.type = "button";
			btn.dataset.tip = isMath ? "Copy LaTeX" : "Copy code";
			btn.setAttribute(
				"aria-label",
				isMath ? "Copy this formula's LaTeX source" : "Copy this code block",
			);
			btn.innerHTML = copySvg;
			let timer: number | undefined;
			btn.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(textOf());
				} catch {
					/* clipboard unavailable: no false confirmation */
					return;
				}
				live.textContent = "Copied";
				btn.innerHTML = checkSvg;
				btn.classList.add("copied");
				clearTimeout(timer);
				timer = window.setTimeout(() => {
					btn.innerHTML = copySvg;
					btn.classList.remove("copied");
					live.textContent = "";
				}, 1200);
			});
			wrap.append(btn);
		}
	}
</script>

<style>
  /* —— out-of-flow art backdrop: occupies no space, scrolls with the
   * page, fades out via mask. Content panels occlude it; the art
   * bleeds through the gutters and margins. —— */
  .post-page {
    position: relative;
  }

  .post-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 360px;
    z-index: 0;
    opacity: 0.6;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 75%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 75%, transparent 100%);
  }

  .post-backdrop img,
  .backdrop-svg,
  .backdrop-svg :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .post-page :global(.post-shell) {
    position: relative;
    z-index: 1;
  }

  /* the bottom spacing .post-shell used to carry, moved inside the grid
   * row so it doesn't shrink the sticky rail's travel zone (home/about
   * shells keep their own padding and no extra spacing here) */
  .post-page :global(.post-main) {
    padding-bottom: 3rem;
  }

  /* title legibility: a soft halo hugging the letterforms (no panel,
   * art stays visible) plus the generator's quiet zone behind it */
  .post-header {
    position: relative;
    max-width: var(--prose-measure);
    margin-bottom: 1.6rem;
  }

  .post-header h1 {
    font-size: 2.1rem;
    line-height: 1.1;
    margin: 0 0 0.5rem;
    text-shadow:
      0 0 11px var(--bg),
      0 0 22px var(--bg),
      0 0 40px var(--bg),
      0 0 66px var(--bg);
  }

  .post-date {
    --rt-lift: -0.5px;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.72rem;
    color: var(--date-color);
    margin: 0;
    text-shadow:
      0 0 9px var(--bg),
      0 0 18px var(--bg),
      0 0 31px var(--bg);
  }
</style>
