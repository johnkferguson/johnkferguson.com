#!/usr/bin/env bash
#
# Refuse a commit where package.json's packageManager and devenv's nixpkgs
# name different pnpm versions (see scripts/check-pnpm-version.sh). Runs only
# when package.json, devenv.lock or devenv.nix is staged.
#
# Enabled by the same `git config core.hooksPath .githooks` as pre-push.
# Bypassing it is `git commit --no-verify`.

set -euo pipefail

# Read the list in full before matching, so an early grep exit cannot
# SIGPIPE git and skip the check under pipefail.
staged=$(git diff --cached --name-only --diff-filter=AM)
grep -qxE 'package\.json|devenv\.lock|devenv\.nix' <<<"$staged" || exit 0
exec bash scripts/check-pnpm-version.sh
